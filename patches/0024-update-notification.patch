+++ b/chrome/browser/yatesium_update_notifier.h
@@ -0,0 +1,23 @@
+// Yatesium: tells the user when a newer release is available.
+//
+// Twice a day, while the browser runs, the updater that ships next to the
+// browser (yatesium_update.exe --check) looks for a newer release. It
+// downloads nothing. If there is one, every window shows a bar that names
+// the version and has an "Update" button. The button opens the About page,
+// which downloads the release, installs it when the browser closes, and
+// offers to relaunch.
+//
+// An empty file Data\no-update.txt turns the check off.
+
+#ifndef CHROME_BROWSER_YATESIUM_UPDATE_NOTIFIER_H_
+#define CHROME_BROWSER_YATESIUM_UPDATE_NOTIFIER_H_
+
+namespace yatesium {
+
+// Starts the checks. Call once, on the UI thread, after the browser has
+// started.
+void StartUpdateNotifier();
+
+}  // namespace yatesium
+
+#endif  // CHROME_BROWSER_YATESIUM_UPDATE_NOTIFIER_H_
