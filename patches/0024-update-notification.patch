diff --git a/chrome/browser/yatesium_update_notifier.cc b/chrome/browser/yatesium_update_notifier.cc
new file mode 100644
index 00000000..13d5bc57
--- /dev/null
+++ b/chrome/browser/yatesium_update_notifier.cc
@@ -0,0 +1,228 @@
+// Yatesium: tells the user when a newer release is available. See
+// yatesium_update_notifier.h.
+
+#include "chrome/browser/yatesium_update_notifier.h"
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/base_paths.h"
+#include "base/files/file.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/path_service.h"
+#include "base/process/launch.h"
+#include "base/process/process.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/task_traits.h"
+#include "base/task/thread_pool.h"
+#include "base/time/time.h"
+#include "chrome/browser/devtools/global_confirm_info_bar.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/chrome_pages.h"
+#include "components/infobars/core/confirm_infobar_delegate.h"
+#include "components/infobars/core/infobar_delegate.h"
+#include "content/public/browser/browser_task_traits.h"
+#include "content/public/browser/browser_thread.h"
+
+namespace yatesium {
+
+namespace {
+
+// The first look happens this long after the browser has started.
+constexpr base::TimeDelta kStartDelay = base::Seconds(60);
+// How often the notifier wakes up to see whether a check is due. A check that
+// failed, for example with no network, is tried again at the next wake-up.
+constexpr base::TimeDelta kWakeInterval = base::Minutes(30);
+// A check is due when the last one that got an answer is this old.
+constexpr base::TimeDelta kCheckInterval = base::Hours(12);
+// The updater normally answers within seconds.
+constexpr base::TimeDelta kCheckTimeout = base::Minutes(2);
+
+struct CheckOutcome {
+  // The newer release, such as "159.0.8154.34-2". Empty if there is none.
+  std::string available_version;
+  // True if the updater was run just now and got an answer.
+  bool checked_now = false;
+};
+
+// Reads the first line of a small text file.
+std::string ReadFirstLine(const base::FilePath& path) {
+  std::string text;
+  if (!base::ReadFileToStringWithMaxSize(path, &text, 4096)) {
+    return std::string();
+  }
+  const size_t end = text.find_first_of("\r\n");
+  if (end != std::string::npos) {
+    text.resize(end);
+  }
+  return std::string(base::TrimWhitespaceASCII(text, base::TRIM_ALL));
+}
+
+// A version is digits with dots and one dash, such as "159.0.8154.34-2".
+// Anything else is not shown to the user.
+bool LooksLikeVersion(const std::string& text) {
+  if (text.empty() || text.size() > 40) {
+    return false;
+  }
+  for (char c : text) {
+    if (!base::IsAsciiDigit(c) && c != '.' && c != '-') {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Runs the updater's check if one is due, then reads what the last check
+// found. Does file access and waits for the updater: runs on the thread pool.
+CheckOutcome CheckIfDue() {
+  CheckOutcome outcome;
+  base::FilePath install_dir;
+  if (!base::PathService::Get(base::DIR_EXE, &install_dir)) {
+    return outcome;
+  }
+  const base::FilePath updater = install_dir.Append(L"yatesium_update.exe");
+  const base::FilePath data_dir = install_dir.AppendASCII("Data");
+  if (!base::PathExists(updater) ||
+      base::PathExists(data_dir.AppendASCII("no-update.txt"))) {
+    return outcome;
+  }
+  const base::FilePath update_dir = data_dir.AppendASCII("Update");
+
+  // The updater rewrites this file whenever a check gets an answer, also for
+  // a check from the About page.
+  const base::FilePath stamp_path = update_dir.AppendASCII("last-check.txt");
+  const base::Time now = base::Time::Now();
+  base::File::Info stamp;
+  const bool has_stamp = base::GetFileInfo(stamp_path, &stamp);
+  const bool due = !has_stamp || stamp.last_modified > now ||
+                   now - stamp.last_modified >= kCheckInterval;
+  if (due) {
+    const std::wstring command_line = L"\"" + updater.value() + L"\" --check";
+    base::LaunchOptions options;
+    options.start_hidden = true;
+    const base::Process process = base::LaunchProcess(command_line, options);
+    int exit_code = 0;
+    if (process.IsValid() &&
+        process.WaitForExitWithTimeout(kCheckTimeout, &exit_code)) {
+      // The check counts only if it got an answer. It gets none without a
+      // network, or while another updater is at work in this folder.
+      base::File::Info new_stamp;
+      outcome.checked_now =
+          base::GetFileInfo(stamp_path, &new_stamp) &&
+          (!has_stamp || new_stamp.last_modified != stamp.last_modified);
+    }
+  }
+
+  // "available <version>", "uptodate <version>" or "failed <reason>".
+  const std::string result = ReadFirstLine(update_dir.AppendASCII("check.txt"));
+  const std::string prefix = "available ";
+  if (!base::StartsWith(result, prefix)) {
+    return outcome;
+  }
+  const std::string version = result.substr(prefix.size());
+  // After the update is installed the old answer is still in the file.
+  if (!LooksLikeVersion(version) ||
+      version == ReadFirstLine(install_dir.AppendASCII("version.txt"))) {
+    return outcome;
+  }
+  outcome.available_version = version;
+  return outcome;
+}
+
+// The bar that every window shows. "Update" opens the About page, which does
+// the download. The close button puts the question off until the next check.
+class UpdateInfoBarDelegate : public ConfirmInfoBarDelegate {
+ public:
+  explicit UpdateInfoBarDelegate(const std::string& version)
+      : version_(base::ASCIIToUTF16(version)) {}
+  UpdateInfoBarDelegate(const UpdateInfoBarDelegate&) = delete;
+  UpdateInfoBarDelegate& operator=(const UpdateInfoBarDelegate&) = delete;
+  ~UpdateInfoBarDelegate() override = default;
+
+  // ConfirmInfoBarDelegate:
+  infobars::InfoBarDelegate::InfoBarIdentifier GetIdentifier() const override {
+    // The identifier is only used for Chromium's statistics, which Yatesium
+    // does not send. An existing value is used so that this file does not
+    // have to change Chromium's list, which grows with every release.
+    return TEST_INFOBAR;
+  }
+  std::u16string GetMessageText() const override {
+    return u"Yatesium " + version_ + u" is available.";
+  }
+  int GetButtons() const override { return BUTTON_OK; }
+  std::u16string GetButtonLabel(InfoBarButton button) const override {
+    return u"Update";
+  }
+  bool ShouldExpire(const NavigationDetails& details) const override {
+    return false;
+  }
+  bool Accept() override {
+    BrowserWindowInterface* browser =
+        GlobalBrowserCollection::GetInstance()->GetLastActiveBrowser();
+    if (browser) {
+      chrome::ShowAboutChrome(browser);
+    }
+    return true;
+  }
+
+ private:
+  const std::u16string version_;
+};
+
+struct NotifierState {
+  // The bar, while it is showing.
+  base::WeakPtr<GlobalConfirmInfoBar> infobar;
+  // True once the bar has been shown since the browser started.
+  bool shown = false;
+};
+
+NotifierState& GetState() {
+  static base::NoDestructor<NotifierState> state;
+  return *state;
+}
+
+void WakeUp();
+
+void OnChecked(CheckOutcome outcome) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  NotifierState& state = GetState();
+  // The bar comes up once after the browser starts and again after each new
+  // check, so a closed bar returns about twice a day.
+  if (!outcome.available_version.empty() && !state.infobar &&
+      (outcome.checked_now || !state.shown)) {
+    state.shown = true;
+    state.infobar = GlobalConfirmInfoBar::Show(
+                        std::make_unique<UpdateInfoBarDelegate>(
+                            outcome.available_version))
+                        ->GetWeakPtr();
+  }
+  content::GetUIThreadTaskRunner({})->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&WakeUp), kWakeInterval);
+}
+
+void WakeUp() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::WithBaseSyncPrimitives(),
+       base::TaskPriority::BEST_EFFORT,
+       base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+      base::BindOnce(&CheckIfDue), base::BindOnce(&OnChecked));
+}
+
+}  // namespace
+
+void StartUpdateNotifier() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  content::GetUIThreadTaskRunner({})->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&WakeUp), kStartDelay);
+}
+
+}  // namespace yatesium
