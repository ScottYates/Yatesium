+// Yatesium: the import page (yatesium://import, chrome://import).
+//
+// The page lists the bookmarks, web apps and extensions found in other
+// Chromium-based browsers of the same Windows account and imports what the
+// user clicks. Nothing is read from another browser until the page is opened,
+// and nothing is imported without a click.
+
+#ifndef CHROME_BROWSER_YATESIUM_IMPORT_H_
+#define CHROME_BROWSER_YATESIUM_IMPORT_H_
+
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/browser/webui_config.h"
+
+namespace content {
+class WebUI;
+}  // namespace content
+
+namespace yatesium {
+
