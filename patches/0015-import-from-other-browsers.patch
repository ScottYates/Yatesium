+base::FilePath AppendRelative(const base::FilePath& root,
+                              std::string_view relative) {
+  base::FilePath path = root;
+  size_t start = 0;
+  while (start <= relative.size()) {
+    size_t end = relative.find('/', start);
+    if (end == std::string_view::npos) {
+      end = relative.size();
+    }
+    path = path.AppendASCII(relative.substr(start, end - start));
+    start = end + 1;
+  }
+  return path;
+}
+
+// Copies a folder with everything in it and carries on past files that cannot
+// be copied. Lock files of databases are left out. Returns false if anything
+// was skipped because of an error.
+bool CopyTree(const base::FilePath& from, const base::FilePath& to) {
+  if (!base::CreateDirectory(to)) {
+    return false;
+  }
+  bool ok = true;
+  base::FileEnumerator entries(
+      from, /*recursive=*/false,
+      base::FileEnumerator::FILES | base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath entry = entries.Next(); !entry.empty();
+       entry = entries.Next()) {
+    const base::FilePath target = to.Append(entry.BaseName());
+    if (entries.GetInfo().IsDirectory()) {
+      ok = CopyTree(entry, target) && ok;
+    } else if (entry.BaseName().AsUTF8Unsafe() != "LOCK") {
+      ok = base::CopyFile(entry, target) && ok;
+    }
+  }
+  return ok;
+}
