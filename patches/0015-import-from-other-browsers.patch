+// ---------------------------------------------------------------------------
+// The page.
+
+bool IsAppInstalledHere(Profile* profile, const std::string& app_id) {
+  web_app::WebAppProvider* provider =
+      web_app::WebAppProvider::GetForWebApps(profile);
+  return provider && provider->is_registry_ready() &&
+         provider->registrar_unsafe().GetAppById(app_id) != nullptr;
+}
+
+bool IsExtensionInstalledHere(Profile* profile, const std::string& id) {
+  return extensions::ExtensionRegistry::Get(profile)->GetInstalledExtension(
+             id) != nullptr;
+}
+
+std::string Escape(std::string_view text) {
+  return base::EscapeForHTML(text);
+}
+
+std::string PageStart() {
+  return "<!doctype html><html><head><meta charset=\"utf-8\">"
+         "<title>Import and export</title></head><body>"
+         "<h1>Import and export</h1>";
+}
+
+std::string PageEnd() {
+  return "</body></html>";
+}
+
+std::string BuildMessagePage(const std::string& message) {
+  return PageStart() + "<p>" + Escape(message) +
+         "</p><p><a href=\"./\">Back to the list</a></p>" + PageEnd();
+}
+
+// Makes a new token for the links and forms of the page being built. The
+// token is valid for one action.
+const std::string& NewToken() {
+  ScanState& state = GetScanState();
+  state.token = base::UnguessableToken::Create().ToString();
+  return state.token;
+}
+
+// `label` is HTML and must already be escaped.
+std::string Checkbox(const std::string& name,
+                     const std::string& value,
+                     bool checked,
+                     const std::string& label) {
+  return "<label><input type=\"checkbox\" name=\"" + Escape(name) +
+         "\" value=\"" + Escape(value) + "\"" + (checked ? " checked" : "") +
+         "> " + label + "</label>";
+}
+
+// Returns the form with a checkbox for each thing of `source` that is not
+// here yet, or an empty string if there is nothing. `source_id` goes back to
+// the page in the "p" field and tells which source the form is for.
+std::string BuildSourceForm(Profile* profile,
+                            const SourceProfile& source,
+                            const std::string& source_id,
+                            bool offer_settings,
+                            size_t engine_count) {
+  std::string items;
+
+  if (offer_settings) {
+    items += "<h3>Settings</h3><p>" +
+             Checkbox("s", "1", /*checked=*/true,
+                      "Browser settings. Settings in the file replace the "
+                      "current ones where they differ.") +
+             "</p>";
+  }
+
+  if (engine_count > 0) {
+    items += "<h3>Search engines</h3><p>" +
+             Checkbox("q", "1", /*checked=*/true,
+                      base::NumberToString(engine_count) +
+                          " search engines you added. One whose keyword is "
+                          "already in use here is skipped.") +
+             "</p>";
+  }
+
+  if (source.bookmark_count > 0) {
+    items += "<h3>Bookmarks</h3><p>" +
+             Checkbox("b", "1", /*checked=*/true,
+                      base::NumberToString(source.bookmark_count) +
+                          " bookmarks") +
+             "</p>";
+  }
+
+  std::string app_items;
+  for (const AppEntry& app : source.apps) {
+    if (IsAppInstalledHere(profile, app.app_id)) {
+      continue;
+    }
+    app_items += "<li>" +
+                 Checkbox("a", app.app_id, /*checked=*/true,
+                          Escape(app.name) + " (" +
+                              Escape(app.start_url.GetHost()) + ")") +
+                 "</li>";
+  }
+  if (!app_items.empty()) {
+    items += "<h3>Web apps</h3><ul>" + app_items + "</ul>";
+  }
+
+  std::string extension_items;
+  for (const ExtensionEntry& extension : source.extensions) {
+    if (IsExtensionInstalledHere(profile, extension.id)) {
+      continue;
+    }
+    extension_items +=
+        "<li>" +
+        Checkbox("e", extension.id, /*checked=*/false,
+                 Escape(extension.name) + " " + Escape(extension.version)) +
+        "</li>";
+  }
+  if (!extension_items.empty()) {
+    items += "<h3>Extensions</h3><ul>" + extension_items + "</ul>";
+  }
+
+  if (items.empty()) {
+    return std::string();
+  }
+  return "<form action=\"run\" method=\"get\">"
+         "<input type=\"hidden\" name=\"t\" value=\"" +
+         Escape(GetScanState().token) +
+         "\"><input type=\"hidden\" name=\"p\" value=\"" + Escape(source_id) +
+         "\">" + items +
+         "<p><button type=\"submit\">Import selected</button></p></form>";
+}
+
+// The main page: the settings file actions, then one form per profile of
+// another browser.
+std::string BuildListPage(Profile* profile) {
+  ScanState& state = GetScanState();
+  const std::string token = NewToken();
+  std::string html = PageStart();
+  html +=
+      "<h2>Settings file</h2>"
+      "<p>A settings file holds this browser's bookmarks, web apps, settings, "
+      "the search engines you added, and extensions with their data. Use it as a backup or to set up "
+      "another copy of Yatesium. It does not hold history, saved passwords "
+      "or sign-ins.</p>"
+      "<p><a href=\"export?t=" +
+      Escape(token) +
+      "\">Export to a settings file...</a></p>"
+      "<p><a href=\"open?t=" +
+      Escape(token) +
+      "\">Import from a settings file...</a></p>"
+      "<hr><h2>Other browsers</h2>"
+      "<p>This part lists what was found in other Chromium-based browsers of "
+      "your Windows account. Tick what you want and click \"Import "
+      "selected\". Nothing is imported before that.</p>"
+      "<ul>"
+      "<li>Bookmarks are added to a new folder on the bookmark bar.</li>"
+      "<li>Web apps are installed here, and the other browser's Start menu "
+      "and desktop shortcuts for them are replaced by new ones. Sign-ins and "
+      "stored data of the apps stay in the other browser.</li>"
+      "<li>Extensions are copied with the permissions they had. Their "
+      "settings are not copied. They are not ticked to begin with: choose "
+      "the ones you want.</li>"
+      "</ul>";
+  if (state.profiles.empty()) {
+    html += "<p><b>No other browser with something to import was "
+            "found.</b></p>";
+  }
+  for (size_t index = 0; index < state.profiles.size(); ++index) {
+    const SourceProfile& source = state.profiles[index];
+    html += "<hr><h3>" + Escape(source.browser) + " (" +
+            Escape(source.profile_name) + ")</h3>";
+    const std::string form =
+        BuildSourceForm(profile, source, base::NumberToString(index),
+                        /*offer_settings=*/false, /*engine_count=*/0);
+    html += form.empty() ? "<p>Everything from this profile is already here.</p>"
+                         : form;
+  }
+  html += PageEnd();
+  return html;
+}
+
+// The page for a settings file that was just opened: replace everything, or
+// add chosen things.
+std::string BuildFilePage(Profile* profile) {
+  ScanState& state = GetScanState();
+  if (!state.file) {
+    return BuildMessagePage("No settings file is open.");
+  }
+  const std::string token = NewToken();
+  const SourceProfile& source = *state.file;
+  std::string html = PageStart();
+  html += "<h2>Settings file: " + Escape(source.profile_name) + "</h2>";
+  html += "<p>It holds " + base::NumberToString(source.bookmark_count) +
+          " bookmarks, " + base::NumberToString(source.apps.size()) +
+          " web apps, " + base::NumberToString(source.extensions.size()) +
+          " extensions and " +
+          base::NumberToString(state.file_engines.size()) +
+          " search engines you added" +
+          (state.file_has_settings ? ", and browser settings." : ".") + "</p>";
+
+  html +=
+      "<hr><h3>Replace everything</h3>"
+      "<p>Makes this browser match the file: bookmarks, settings, search "
+      "engines you added, web apps, and extensions with their data. What is "
+      "here now in those areas is overwritten, including bookmarks, search "
+      "engines, web apps and extensions that the file does not have. History, saved passwords and sign-ins are kept. "
+      "The browser closes and starts again.</p>"
+      "<form action=\"restore\" method=\"get\">"
+      "<input type=\"hidden\" name=\"t\" value=\"" +
+      Escape(token) +
+      "\"><p><button type=\"submit\">Replace everything and relaunch"
+      "</button></p></form>";
+
+  html += "<hr><h3>Add to this browser</h3>"
+          "<p>Adds what you tick to what is already here. Things that are "
+          "already here are not listed. An extension brings its stored data "
+          "along if this browser has none for it.</p>";
+  const std::string form =
+      BuildSourceForm(profile, source, "file", state.file_has_settings,
+                      state.file_engines.size());
+  html += form.empty() ? "<p>Everything in the file is already here.</p>" : form;
+  html += "<p><a href=\"./\">Back to the list</a></p>";
+  html += PageEnd();
+  return html;
+}
+
+bool Contains(const std::vector<std::string>& list, const std::string& item) {
+  for (const std::string& entry : list) {
+    if (entry == item) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Checks the token of a link or form and uses it up, so that reloading the
+// resulting page does nothing a second time.
+bool ConsumeToken(const GURL& url) {
+  std::string token;
+  for (net::QueryIterator it(url); !it.IsAtEnd(); it.Advance()) {
+    if (it.GetKey() == "t") {
+      token = it.GetUnescapedValue();
+    }
+  }
+  ScanState& state = GetScanState();
+  if (state.token.empty() || token != state.token) {
+    return false;
+  }
+  state.token.clear();
+  return true;
+}
+
+constexpr char kExpiredMessage[] =
+    "This page is no longer valid. Nothing was changed.";
+
+// Carries out the import that a submitted form asked for and returns the
+// page to show.
+std::string RunImport(Profile* profile, const GURL& url) {
+  std::string source_id;
+  bool settings_ticked = false;
+  bool engines_ticked = false;
+  bool bookmarks_ticked = false;
+  std::vector<std::string> app_ids;
+  std::vector<std::string> extension_ids;
+  for (net::QueryIterator it(url); !it.IsAtEnd(); it.Advance()) {
+    const std::string_view key = it.GetKey();
+    const std::string value = it.GetUnescapedValue();
+    if (key == "p") {
+      source_id = value;
+    } else if (key == "s") {
+      settings_ticked = true;
+    } else if (key == "q") {
+      engines_ticked = true;
+    } else if (key == "b") {
+      bookmarks_ticked = true;
+    } else if (key == "a") {
+      app_ids.push_back(value);
+    } else if (key == "e") {
+      extension_ids.push_back(value);
+    }
+  }
+
+  if (!ConsumeToken(url)) {
+    return BuildMessagePage(kExpiredMessage);
+  }
+  ScanState& state = GetScanState();
+  const SourceProfile* source = nullptr;
+  if (source_id == "file") {
+    if (state.file) {
+      source = &*state.file;
+    }
+  } else {
+    int index = -1;
+    if (base::StringToInt(source_id, &index) && index >= 0 &&
+        static_cast<size_t>(index) < state.profiles.size()) {
+      source = &state.profiles[index];
+    }
+  }
+  if (!source) {
+    return BuildMessagePage(kExpiredMessage);
+  }
+
+  const bool settings = settings_ticked && source->from_settings_file &&
+                        state.file_has_settings;
+  const bool engines = engines_ticked && source->from_settings_file &&
+                       !state.file_engines.empty();
+  const bool bookmarks = bookmarks_ticked && source->bookmark_count > 0;
+  std::vector<AppEntry> apps;
+  std::vector<ExtensionEntry> extensions;
+  for (const AppEntry& app : source->apps) {
+    if (Contains(app_ids, app.app_id) &&
+        !IsAppInstalledHere(profile, app.app_id)) {
+      apps.push_back(app);
+    }
+  }
+  for (const ExtensionEntry& extension : source->extensions) {
+    if (Contains(extension_ids, extension.id) &&
+        !IsExtensionInstalledHere(profile, extension.id)) {
+      extensions.push_back(extension);
+    }
+  }
+
+  if (!settings && !engines && !bookmarks && apps.empty() &&
+      extensions.empty()) {
+    return BuildMessagePage("Nothing was selected. Nothing was imported.");
+  }
+
+  if (settings) {
+    ImportSettings(profile, source->profile_dir);
+  }
+  if (engines) {
+    AddEngines(profile, state.file_engines, /*replace=*/false);
+  }
+  if (bookmarks) {
+    ImportBookmarks(profile, *source);
+  }
+  ImportApps(profile, *source, apps);
+  for (const ExtensionEntry& extension : extensions) {
+    // Only a settings file brings the extensions' stored data.
+    ImportExtension(profile, extension,
+                    source->from_settings_file ? source->profile_dir
+                                               : base::FilePath());
+  }
+
+  std::string message = "Importing from " + source->browser + " (" +
+                        source->profile_name + "): ";
+  if (settings) {
+    message += "settings, ";
+  }
+  if (engines) {
+    message += "search engines, ";
+  }
+  message += bookmarks ? base::NumberToString(source->bookmark_count) : "0";
+  message += " bookmarks, " + base::NumberToString(apps.size()) +
+             " web apps, " + base::NumberToString(extensions.size()) +
+             " extensions. This takes a moment. Web apps and extensions "
+             "appear on their own pages when they are installed.";
+  return BuildMessagePage(message);
+}
+
+void Respond(content::URLDataSource::GotDataCallback callback,
+             const std::string& html) {
+  std::move(callback).Run(base::MakeRefCounted<base::RefCountedString>(html));
+}
+
+void OnScanDone(base::WeakPtr<Profile> profile,
+                content::URLDataSource::GotDataCallback callback,
+                std::vector<SourceProfile> profiles) {
+  if (!profile) {
+    Respond(std::move(callback), std::string());
+    return;
+  }
+  GetScanState().profiles = std::move(profiles);
+  LoadEngines(profile.get());
+  Respond(std::move(callback), BuildListPage(profile.get()));
+}
