+constexpr BrowserDef kBrowsers[] = {
+    {"Brave", FILE_PATH_LITERAL("BraveSoftware\\Brave-Browser\\User Data"),
+     "\\bravesoftware\\"},
+    {"Google Chrome", FILE_PATH_LITERAL("Google\\Chrome\\User Data"),
+     "\\google\\chrome\\"},
+    {"Microsoft Edge", FILE_PATH_LITERAL("Microsoft\\Edge\\User Data"),
+     "\\microsoft\\edge\\"},
+    {"Vivaldi", FILE_PATH_LITERAL("Vivaldi\\User Data"), "\\vivaldi\\"},
+    {"Chromium", FILE_PATH_LITERAL("Chromium\\User Data"), "\\chromium\\"},
+};
