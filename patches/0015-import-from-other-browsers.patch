+struct BrowserDef {
+  // Name shown on the page.
+  const char* label;
+  // Data folder, relative to the local application data folder.
+  const base::FilePath::CharType* user_data;
+  // Lower-case part of the path of the browser's program files. A shortcut is
+  // taken to belong to this browser if its target contains this text.
+  const char* program_path_part;
+};
