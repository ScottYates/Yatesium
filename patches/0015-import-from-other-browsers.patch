+// Export: ask where to save, write pending settings to disk, build the zip.
+
+void OnExportDone(const base::FilePath& path,
+                  content::URLDataSource::GotDataCallback callback,
+                  bool ok) {
+  Respond(std::move(callback),
+          BuildMessagePage(ok ? "The settings file was saved as " +
+                                    path.AsUTF8Unsafe() + "."
+                              : "The settings file could not be written."));
+}
+
+void RunExport(const base::FilePath& profile_dir,
+               const base::FilePath& path,
+               const std::string& engines_json,
+               content::URLDataSource::GotDataCallback callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&ExportSettings, profile_dir, path, engines_json),
+      base::BindOnce(&OnExportDone, path, std::move(callback)));
+}
+
+void OnExportPathChosen(base::WeakPtr<Profile> profile,
+                        content::URLDataSource::GotDataCallback callback,
+                        const base::FilePath& path) {
+  if (!profile || path.empty()) {
+    Respond(std::move(callback), BuildMessagePage("Nothing was exported."));
+    return;
+  }
+  // The settings on disk can be a little behind. Write them out first.
+  profile->GetPrefs()->CommitPendingWrite(
+      base::BindOnce(&RunExport, profile->GetPath(), path,
+                     EnginesToJson(profile.get()), std::move(callback)));
+}
+
+// Import from a file: ask which file, unpack it, show what it holds.
+
+void OnFileOpened(base::WeakPtr<Profile> profile,
+                  content::URLDataSource::GotDataCallback callback,
+                  OpenedFile opened) {
+  if (!profile || !opened.ok) {
+    Respond(std::move(callback),
+            BuildMessagePage("This is not a Yatesium settings file, or it "
+                             "could not be read. Nothing was changed."));
+    return;
+  }
+  ScanState& state = GetScanState();
+  if (!state.file_temp_dir.empty()) {
+    base::ThreadPool::PostTask(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+        base::GetDeletePathRecursivelyCallback(state.file_temp_dir));
+  }
+  state.file = std::move(opened.source);
+  state.file_temp_dir = opened.temp_dir;
+  state.file_has_settings = opened.has_settings;
+  state.file_engines = std::move(opened.engines);
+  LoadEngines(profile.get());
+  Respond(std::move(callback), BuildFilePage(profile.get()));
+}
+
+void OnImportPathChosen(base::WeakPtr<Profile> profile,
+                        content::URLDataSource::GotDataCallback callback,
+                        const base::FilePath& path) {
+  if (!profile || path.empty()) {
+    Respond(std::move(callback), BuildMessagePage("No file was chosen."));
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&OpenSettingsFile, path),
+      base::BindOnce(&OnFileOpened, profile, std::move(callback)));
+}
+
+// Replace everything: stage the unpacked file in the profile and relaunch.
+
+void OnRestoreStaged(content::URLDataSource::GotDataCallback callback,
+                     bool ok) {
+  if (!ok) {
+    Respond(std::move(callback),
+            BuildMessagePage("The settings file could not be prepared. "
+                             "Nothing was changed."));
+    return;
+  }
+  Respond(std::move(callback),
+          BuildMessagePage("The browser is starting again with the settings "
+                           "from the file."));
+  chrome::AttemptRestart();
+}
+
+void StartRestore(Profile* profile,
+                  content::URLDataSource::GotDataCallback callback) {
+  ScanState& state = GetScanState();
+  if (!state.file) {
+    Respond(std::move(callback), BuildMessagePage(kExpiredMessage));
+    return;
+  }
+  const base::FilePath unpacked = state.file->profile_dir;
+  // Search engines are kept in a database that cannot be swapped like the
+  // other files, so they are replaced here, before the relaunch.
+  AddEngines(profile, state.file_engines, /*replace=*/true);
+  // The unpacked files are moved away, so the file is no longer open here.
+  state.file.reset();
+  state.file_engines.clear();
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+      base::BindOnce(&StageRestore, unpacked, profile->GetPath()),
+      base::BindOnce(&OnRestoreStaged, std::move(callback)));
+}
+
+class ImportSource : public content::URLDataSource {
+ public:
+  explicit ImportSource(Profile* profile) : profile_(profile->GetWeakPtr()) {}
+  ImportSource(const ImportSource&) = delete;
+  ImportSource& operator=(const ImportSource&) = delete;
+  ~ImportSource() override = default;
+
+  // content::URLDataSource:
+  std::string GetSource() override { return kImportHost; }
+
+  void StartDataRequest(
+      const GURL& url,
+      const content::WebContents::Getter& wc_getter,
+      content::URLDataSource::GotDataCallback callback) override {
+    if (!profile_) {
+      Respond(std::move(callback), std::string());
+      return;
+    }
+    const std::string path(url.path());
+    if (path == "/run") {
+      Respond(std::move(callback), RunImport(profile_.get(), url));
+      return;
+    }
+    if (path == "/export" || path == "/open" || path == "/restore") {
+      if (!ConsumeToken(url)) {
+        Respond(std::move(callback), BuildMessagePage(kExpiredMessage));
+        return;
+      }
+      if (path == "/restore") {
+        StartRestore(profile_.get(), std::move(callback));
+        return;
+      }
+      content::WebContents* web_contents = wc_getter.Run();
+      const gfx::NativeWindow owner =
+          web_contents ? web_contents->GetTopLevelNativeWindow()
+                       : gfx::NativeWindow();
+      if (path == "/export") {
+        FilePicker::Show(/*save=*/true, owner,
+                         base::BindOnce(&OnExportPathChosen, profile_,
+                                        std::move(callback)));
+      } else {
+        FilePicker::Show(/*save=*/false, owner,
+                         base::BindOnce(&OnImportPathChosen, profile_,
+                                        std::move(callback)));
+      }
+      return;
+    }
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE,
+        {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+         base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+        base::BindOnce(&ScanSources),
+        base::BindOnce(&OnScanDone, profile_, std::move(callback)));
+  }
+
+  std::string GetMimeType(const GURL& url) override { return "text/html"; }
+
+  bool AllowCaching() override { return false; }
+
+ private:
+  base::WeakPtr<Profile> profile_;
+};
+
+}  // namespace
+
+bool OtherBrowserDataExists() {
+  base::FilePath local_app_data;
+  if (!base::PathService::Get(base::DIR_LOCAL_APP_DATA, &local_app_data)) {
+    return false;
+  }
+  for (const BrowserDef& browser : kBrowsers) {
+    if (base::DirectoryExists(local_app_data.Append(browser.user_data))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void ApplyPendingRestore(const base::FilePath& user_data_dir) {
+  std::vector<base::FilePath> profile_dirs;
+  {
+    base::FileEnumerator dirs(user_data_dir, /*recursive=*/false,
+                              base::FileEnumerator::DIRECTORIES);
+    for (base::FilePath dir = dirs.Next(); !dir.empty(); dir = dirs.Next()) {
+      profile_dirs.push_back(dir);
+    }
+  }
+  for (const base::FilePath& profile_dir : profile_dirs) {
+    const base::FilePath restore_dir = profile_dir.AppendASCII(kRestoreDirName);
+    if (!base::PathExists(restore_dir.AppendASCII(kRestoreReadyFile))) {
+      continue;
+    }
+    const base::FilePath source = restore_dir.AppendASCII(kSettingsProfileDir);
+    if (base::DirectoryExists(source)) {
+      RestoreProfile(profile_dir, source);
+    }
+    base::DeletePathRecursively(restore_dir);
+  }
+}
+
+ImportUI::ImportUI(content::WebUI* web_ui) : WebUIController(web_ui) {
+  // Not offered in incognito and guest windows: the import changes the
+  // regular profile.
+  Profile* profile = Profile::FromWebUI(web_ui)->GetOriginalProfile();
+  content::URLDataSource::Add(Profile::FromWebUI(web_ui),
+                              std::make_unique<ImportSource>(profile));
+}
+
+ImportUI::~ImportUI() = default;
+
+ImportUIConfig::ImportUIConfig()
+    : DefaultWebUIConfig(content::kChromeUIScheme, kImportHost) {}
+
+}  // namespace yatesium
