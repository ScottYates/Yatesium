+// Yatesium: the import page (yatesium://import, chrome://import).
+//
+// The page lists the bookmarks, web apps and extensions found in other
+// Chromium-based browsers of the same Windows account and imports what the
+// user clicks. Nothing is read from another browser until the page is opened,
+// and nothing is imported without a click.
+//
+// The page also exports this profile's bookmarks, settings, web apps and
+// extensions to a settings file, and imports from such a file.
+
+#ifndef CHROME_BROWSER_YATESIUM_IMPORT_H_
+#define CHROME_BROWSER_YATESIUM_IMPORT_H_
+
+#include "base/files/file_path.h"
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/browser/webui_config.h"
+
+namespace content {
+class WebUI;
+}  // namespace content
+
+namespace yatesium {
+
+inline constexpr char kImportHost[] = "import";
+inline constexpr char kImportURL[] = "chrome://import/";
+
+// True if the data folder of another Chromium-based browser exists for the
+// current Windows account. Used to decide whether the first run opens the
+// import page. Only checks whether the folders exist.
+bool OtherBrowserDataExists();
+
+// Carries out a "replace everything" import that the page prepared before the
+// browser was relaunched: the profile's bookmarks, settings, web apps and
+// extensions are replaced by the ones from the settings file. Must run at
+// startup before any profile is loaded. Does nothing if nothing is pending.
+void ApplyPendingRestore(const base::FilePath& user_data_dir);
+
+class ImportUI : public content::WebUIController {
+ public:
+  explicit ImportUI(content::WebUI* web_ui);
+  ImportUI(const ImportUI&) = delete;
+  ImportUI& operator=(const ImportUI&) = delete;
+  ~ImportUI() override;
+};
+
+class ImportUIConfig : public content::DefaultWebUIConfig<ImportUI> {
+ public:
+  ImportUIConfig();
+};
+
+}  // namespace yatesium
+
+#endif  // CHROME_BROWSER_YATESIUM_IMPORT_H_
