+struct SourceProfile {
+  std::string browser;
+  std::string program_path_part;
+  std::string profile_name;
+  base::FilePath profile_dir;
+  int bookmark_count = 0;
+  std::vector<AppEntry> apps;
+  std::vector<ExtensionEntry> extensions;
+};
+
+// The result of the last scan and the token of the links on the page that
+// showed it. Used on the UI thread only.
+struct ScanState {
+  std::vector<SourceProfile> profiles;
+  std::string token;
+};
