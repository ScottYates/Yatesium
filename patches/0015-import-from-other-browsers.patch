+std::vector<SourceProfile> ScanSources() {
+  std::vector<SourceProfile> profiles;
+  base::FilePath local_app_data;
+  if (!base::PathService::Get(base::DIR_LOCAL_APP_DATA, &local_app_data)) {
+    return profiles;
+  }
+  for (const BrowserDef& browser : kBrowsers) {
+    const base::FilePath user_data = local_app_data.Append(browser.user_data);
+    base::FileEnumerator dirs(user_data, /*recursive=*/false,
+                              base::FileEnumerator::DIRECTORIES);
+    for (base::FilePath dir = dirs.Next(); !dir.empty(); dir = dirs.Next()) {
+      const std::string name = dir.BaseName().AsUTF8Unsafe();
+      if (name != "Default" && !name.starts_with("Profile ")) {
+        continue;
+      }
+      if (!base::PathExists(dir.AppendASCII("Preferences"))) {
+        continue;
+      }
+      SourceProfile profile;
+      profile.browser = browser.label;
+      profile.program_path_part = browser.program_path_part;
+      profile.profile_name = name;
+      profile.profile_dir = dir;
+      profile.bookmark_count = CountBookmarksInProfile(dir);
+      profile.apps = ReadApps(dir);
+      profile.extensions = ReadExtensions(dir);
+      if (profile.bookmark_count > 0 || !profile.apps.empty() ||
+          !profile.extensions.empty()) {
+        profiles.push_back(std::move(profile));
+      }
+    }
+  }
+  return profiles;
+}
+
+// ---------------------------------------------------------------------------
+// Bookmarks.
+
+void AddBookmarkChildren(bookmarks::BookmarkModel* model,
+                         const bookmarks::BookmarkNode* parent,
+                         const base::DictValue& node,
+                         int depth) {
+  if (depth > kMaxBookmarkDepth) {
+    return;
+  }
+  const base::ListValue* children = node.FindList("children");
+  if (!children) {
+    return;
+  }
+  for (const base::Value& child : *children) {
+    const base::DictValue* dict = child.GetIfDict();
+    if (!dict) {
+      continue;
+    }
+    const std::string* type = dict->FindString("type");
+    const std::string* name = dict->FindString("name");
+    const std::u16string title = name ? base::UTF8ToUTF16(*name) : u"";
+    if (type && *type == "url") {
+      const std::string* url_text = dict->FindString("url");
+      const GURL url(url_text ? *url_text : std::string());
+      if (url.is_valid()) {
+        model->AddURL(parent, parent->children().size(), title, url);
+      }
+    } else {
+      const bookmarks::BookmarkNode* folder =
+          model->AddFolder(parent, parent->children().size(), title);
+      AddBookmarkChildren(model, folder, *dict, depth + 1);
+    }
+  }
+}
+
+bool HasChildren(const base::DictValue* node) {
+  const base::ListValue* children = node ? node->FindList("children") : nullptr;
+  return children && !children->empty();
+}
+
+// Puts the imported bookmarks into a new folder on the bookmark bar, so they
+// stay apart from the bookmarks that are already there.
+void AddBookmarks(base::WeakPtr<Profile> profile,
+                  const std::string& label,
+                  std::optional<base::DictValue> roots) {
+  if (!profile || !roots) {
+    return;
+  }
+  bookmarks::BookmarkModel* model =
+      BookmarkModelFactory::GetForBrowserContext(profile.get());
+  if (!model || !model->loaded()) {
+    return;
+  }
+  const bookmarks::BookmarkNode* bar = model->bookmark_bar_node();
+  const bookmarks::BookmarkNode* folder =
+      model->AddFolder(bar, bar->children().size(),
+                       base::UTF8ToUTF16("Imported from " + label));
+  if (const base::DictValue* node = roots->FindDict("bookmark_bar")) {
+    AddBookmarkChildren(model, folder, *node, 0);
+  }
+  if (const base::DictValue* node = roots->FindDict("other");
+      HasChildren(node)) {
+    const bookmarks::BookmarkNode* other = model->AddFolder(
+        folder, folder->children().size(), u"Other bookmarks");
+    AddBookmarkChildren(model, other, *node, 0);
+  }
+  if (const base::DictValue* node = roots->FindDict("synced");
+      HasChildren(node)) {
+    const bookmarks::BookmarkNode* mobile = model->AddFolder(
+        folder, folder->children().size(), u"Mobile bookmarks");
+    AddBookmarkChildren(model, mobile, *node, 0);
+  }
+}
+
+void ImportBookmarks(Profile* profile, const SourceProfile& source) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&ReadBookmarkRoots, source.profile_dir),
+      base::BindOnce(&AddBookmarks, profile->GetWeakPtr(),
+                     source.browser + " (" + source.profile_name + ")"));
+}
+
+// ---------------------------------------------------------------------------
+// Extensions.
+
+// Copies the extension's files, because the installer takes its input away.
+// Returns the copy, or an empty path.
+base::FilePath CopyExtension(const base::FilePath& dir) {
+  base::FilePath temp_dir;
+  if (!base::CreateNewTempDirectory(FILE_PATH_LITERAL("yatesium_import"),
+                                    &temp_dir)) {
+    return base::FilePath();
+  }
+  const base::FilePath copy = temp_dir.AppendASCII("extension");
+  if (!base::CopyDirectory(dir, copy, /*recursive=*/true)) {
+    base::DeletePathRecursively(temp_dir);
+    return base::FilePath();
+  }
+  return copy;
+}
+
+// Installs the copied files the way an unpacked package from the store is
+// installed. The extension keeps its id and its update address.
+void InstallCopiedExtension(base::WeakPtr<Profile> profile,
+                            const ExtensionEntry& entry,
+                            const base::FilePath& copy) {
+  if (copy.empty()) {
+    return;
+  }
+  if (!profile) {
+    base::ThreadPool::PostTask(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+        base::GetDeletePathRecursivelyCallback(copy.DirName()));
+    return;
+  }
+  scoped_refptr<extensions::CrxInstaller> installer =
+      extensions::CrxInstaller::CreateSilent(profile.get());
+  installer->set_install_source(extensions::mojom::ManifestLocation::kInternal);
+  installer->set_delete_source(true);
+  installer->set_allow_silent_install(true);
+  installer->set_install_immediately(true);
+  if (entry.from_web_store) {
+    installer->set_is_gallery_install(true);
+  } else {
+    installer->set_off_store_install_allow_reason(
+        extensions::CrxInstaller::OffStoreInstallAllowedFromSettingsPage);
+  }
+  installer->InstallUnpackedCrx(entry.id, entry.key, copy);
+}
+
+// Copies the data an extension stored in the profile `from_profile` into the
+// profile `to_profile`, unless the extension already has data there. This is
+// done before the extension is installed, while nothing has its data open.
+void CopyExtensionData(const base::FilePath& from_profile,
+                       const base::FilePath& to_profile,
+                       const std::string& id) {
+  for (const char* dir :
+       {"Local Extension Settings", "Sync Extension Settings"}) {
+    const base::FilePath from = from_profile.AppendASCII(dir).AppendASCII(id);
+    const base::FilePath to = to_profile.AppendASCII(dir).AppendASCII(id);
+    if (base::DirectoryExists(from) && !base::PathExists(to)) {
+      CopyTree(from, to);
+    }
+  }
+  for (const char* suffix : {"_0.indexeddb.leveldb", "_0.indexeddb.blob"}) {
+    const std::string name = kExtensionDatabasePrefix + id + suffix;
+    const base::FilePath from =
+        from_profile.AppendASCII(kIndexedDBDir).AppendASCII(name);
+    const base::FilePath to =
+        to_profile.AppendASCII(kIndexedDBDir).AppendASCII(name);
+    if (base::DirectoryExists(from) && !base::PathExists(to)) {
+      CopyTree(from, to);
+    }
+  }
+}
+
+base::FilePath CopyExtensionAndData(const ExtensionEntry& entry,
+                                    const base::FilePath& data_from,
+                                    const base::FilePath& profile_dir) {
+  if (!data_from.empty()) {
+    CopyExtensionData(data_from, profile_dir, entry.id);
+  }
+  return CopyExtension(entry.dir);
+}
+
+// `data_from` is the profile folder to take the extension's stored data from.
+// It is empty if the data is not imported.
+void ImportExtension(Profile* profile,
+                     const ExtensionEntry& entry,
+                     const base::FilePath& data_from) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&CopyExtensionAndData, entry, data_from,
+                     profile->GetPath()),
+      base::BindOnce(&InstallCopiedExtension, profile->GetWeakPtr(), entry));
+}
+
+// ---------------------------------------------------------------------------
+// Web apps.
+
+// A shortcut of the other browser that was moved out of the way.
+struct MovedShortcut {
+  base::FilePath original;
+  base::FilePath backup;
+};
+
+struct PreparedApp {
+  AppEntry entry;
+  // Icons of the app, by size in pixels.
+  std::map<int, SkBitmap> icons;
+  bool had_desktop_shortcut = false;
+  std::vector<MovedShortcut> moved_shortcuts;
+};
+
+std::map<int, SkBitmap> ReadAppIcons(const base::FilePath& profile_dir,
+                                     const std::string& app_id) {
+  std::map<int, SkBitmap> icons;
+  const base::FilePath dir = profile_dir.AppendASCII("Web Applications")
+                                 .AppendASCII("Manifest Resources")
+                                 .AppendASCII(app_id)
+                                 .AppendASCII("Icons");
+  base::FileEnumerator files(dir, /*recursive=*/false,
+                             base::FileEnumerator::FILES,
+                             FILE_PATH_LITERAL("*.png"));
+  for (base::FilePath file = files.Next(); !file.empty(); file = files.Next()) {
+    std::optional<int64_t> size = base::GetFileSize(file);
+    if (!size || *size <= 0 ||
+        static_cast<uint64_t>(*size) > kMaxIconSize) {
+      continue;
+    }
+    std::optional<std::vector<uint8_t>> bytes = base::ReadFileToBytes(file);
+    if (!bytes) {
+      continue;
+    }
+    SkBitmap bitmap = gfx::PNGCodec::Decode(*bytes);
+    if (bitmap.drawsNothing() || bitmap.width() != bitmap.height()) {
+      continue;
+    }
+    icons[bitmap.width()] = bitmap;
+  }
+  return icons;
+}
+
+struct FoundShortcut {
+  base::FilePath path;
+  bool on_desktop = false;
+  // Lower-case target path and the arguments.
+  std::string target;
+  std::string arguments;
+};
+
+void CollectShortcuts(const base::FilePath& dir,
+                      bool on_desktop,
+                      std::vector<FoundShortcut>* shortcuts) {
+  base::FileEnumerator files(dir, /*recursive=*/false,
+                             base::FileEnumerator::FILES,
+                             FILE_PATH_LITERAL("*.lnk"));
+  for (base::FilePath file = files.Next(); !file.empty(); file = files.Next()) {
+    base::FilePath target;
+    std::wstring arguments;
+    if (!base::win::ResolveShortcut(file, &target, &arguments)) {
+      continue;
+    }
+    FoundShortcut shortcut;
+    shortcut.path = file;
+    shortcut.on_desktop = on_desktop;
+    shortcut.target = base::ToLowerASCII(target.AsUTF8Unsafe());
+    shortcut.arguments = base::WideToUTF8(arguments);
+    shortcuts->push_back(std::move(shortcut));
+  }
+}
+
+// Finds the shortcuts on the desktop and in the Start menu.
+std::vector<FoundShortcut> FindShortcuts() {
+  std::vector<FoundShortcut> shortcuts;
+  base::FilePath desktop;
+  if (base::PathService::Get(base::DIR_USER_DESKTOP, &desktop)) {
+    CollectShortcuts(desktop, /*on_desktop=*/true, &shortcuts);
+  }
+  base::FilePath start_menu;
+  if (base::PathService::Get(base::DIR_START_MENU, &start_menu)) {
+    CollectShortcuts(start_menu, /*on_desktop=*/false, &shortcuts);
+    base::FileEnumerator dirs(start_menu, /*recursive=*/false,
+                              base::FileEnumerator::DIRECTORIES);
+    for (base::FilePath dir = dirs.Next(); !dir.empty(); dir = dirs.Next()) {
+      CollectShortcuts(dir, /*on_desktop=*/false, &shortcuts);
+    }
+  }
+  return shortcuts;
+}
+
+// Reads the icons of the apps and moves the other browser's shortcuts for
+// them into a temporary folder, so the new shortcuts can take their names.
+// Runs on a thread that can use the Windows shell.
+std::vector<PreparedApp> PrepareApps(const base::FilePath& profile_dir,
+                                     const std::string& program_path_part,
+                                     bool replace_shortcuts,
+                                     const std::vector<AppEntry>& apps) {
+  std::vector<PreparedApp> prepared;
+  // A settings file has no shortcuts of another browser to replace.
+  std::vector<FoundShortcut> shortcuts;
+  if (replace_shortcuts) {
+    shortcuts = FindShortcuts();
+  }
+  base::FilePath backup_dir;
+  const bool have_backup_dir = base::CreateNewTempDirectory(
+      FILE_PATH_LITERAL("yatesium_import"), &backup_dir);
+  int backup_number = 0;
+  for (const AppEntry& entry : apps) {
+    PreparedApp app;
+    app.entry = entry;
+    app.icons = ReadAppIcons(profile_dir, entry.app_id);
+    const std::string argument = "--app-id=" + entry.app_id;
+    for (const FoundShortcut& shortcut : shortcuts) {
+      if (shortcut.target.find(program_path_part) == std::string::npos ||
+          shortcut.arguments.find(argument) == std::string::npos) {
+        continue;
+      }
+      app.had_desktop_shortcut |= shortcut.on_desktop;
+      if (!have_backup_dir) {
+        continue;
+      }
+      const base::FilePath backup = backup_dir.AppendASCII(
+          base::NumberToString(backup_number++) + ".lnk");
+      if (base::Move(shortcut.path, backup)) {
+        app.moved_shortcuts.push_back({shortcut.path, backup});
+      }
+    }
+    prepared.push_back(std::move(app));
+  }
+  return prepared;
+}
+
+// Deletes the moved shortcuts if the app was installed, and puts them back if
+// it was not.
+void FinishShortcuts(const std::vector<MovedShortcut>& shortcuts,
+                     bool installed) {
+  for (const MovedShortcut& shortcut : shortcuts) {
+    if (installed) {
+      base::DeleteFile(shortcut.backup);
+    } else {
+      base::Move(shortcut.backup, shortcut.original);
+    }
+  }
+}
+
+void FinishShortcutsOnThreadPool(const std::vector<MovedShortcut>& shortcuts,
+                                 bool installed) {
+  if (shortcuts.empty()) {
+    return;
+  }
+  base::ThreadPool::PostTask(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+      base::BindOnce(&FinishShortcuts, shortcuts, installed));
+}
+
+void OnAppInstalled(const std::vector<MovedShortcut>& shortcuts,
+                    const webapps::AppId& app_id,
+                    webapps::InstallResultCode code) {
+  FinishShortcutsOnThreadPool(shortcuts, webapps::IsSuccess(code));
+}
+
+void InstallPreparedApps(base::WeakPtr<Profile> profile,
+                         std::vector<PreparedApp> apps) {
+  web_app::WebAppProvider* provider =
+      profile ? web_app::WebAppProvider::GetForWebApps(profile.get())
+              : nullptr;
+  for (PreparedApp& app : apps) {
+    const AppEntry& entry = app.entry;
+    std::optional<webapps::ManifestId> manifest_id;
+    if (provider) {
+      manifest_id = entry.manifest_id_path
+                        ? web_app::GenerateManifestIdUnsafe(
+                              *entry.manifest_id_path, entry.start_url)
+                        : std::optional<webapps::ManifestId>(
+                              web_app::GenerateManifestIdFromStartUrlOnly(
+                                  entry.start_url));
+    }
+    if (!manifest_id) {
+      FinishShortcutsOnThreadPool(app.moved_shortcuts, /*installed=*/false);
+      continue;
+    }
+    auto created = web_app::WebAppInstallInfo::Create(GURL(), *manifest_id,
+                                                      entry.start_url);
+    if (!created.has_value()) {
+      FinishShortcutsOnThreadPool(app.moved_shortcuts, /*installed=*/false);
+      continue;
+    }
+    auto info = std::make_unique<web_app::WebAppInstallInfo>(
+        std::move(created.value()));
+    info->title = base::UTF8ToUTF16(entry.name);
+    if (entry.scope.is_valid() &&
+        url::Origin::Create(entry.scope)
+            .IsSameOriginWith(url::Origin::Create(entry.start_url))) {
+      info->scope = entry.scope;
+    }
+    const web_app::mojom::UserDisplayMode user_display_mode =
+        entry.opens_in_window ? web_app::mojom::UserDisplayMode::kStandalone
+                              : web_app::mojom::UserDisplayMode::kBrowser;
+    info->display_mode = blink::mojom::DisplayMode::kStandalone;
+    info->user_display_mode = user_display_mode;
+    for (const auto& icon : app.icons) {
+      info->icon_bitmaps.any[icon.first] = icon.second;
+      info->trusted_icon_bitmaps.any[icon.first] = icon.second;
+    }
+
+    web_app::WebAppInstallParams params;
+    params.user_display_mode = user_display_mode;
+    params.add_to_desktop = app.had_desktop_shortcut;
+    params.add_to_quick_launch_bar = false;
+
+    provider->scheduler().InstallFromInfoWithParams(
+        std::move(info), /*overwrite_existing_manifest_fields=*/false,
+        webapps::WebappInstallSource::MENU_BROWSER_TAB,
+        base::BindOnce(&OnAppInstalled, app.moved_shortcuts), params);
+  }
+}
+
+void ImportApps(Profile* profile,
+                const SourceProfile& source,
+                const std::vector<AppEntry>& apps) {
+  if (apps.empty()) {
+    return;
+  }
+  // Reading shortcuts needs a thread that is set up for the Windows shell.
+  base::ThreadPool::CreateCOMSTATaskRunner(
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN})
+      ->PostTaskAndReplyWithResult(
+          FROM_HERE,
+          base::BindOnce(&PrepareApps, source.profile_dir,
+                         source.program_path_part,
+                         !source.from_settings_file, apps),
+          base::BindOnce(&InstallPreparedApps, profile->GetWeakPtr()));
+}
+
+// ---------------------------------------------------------------------------
+// Settings files. The functions that touch files run on the thread pool.
+
+// Writes the profile's bookmarks, settings, web apps and extensions with
+// their data into the zip `dest_file`.
+bool ExportSettings(const base::FilePath& profile_dir,
+                    const base::FilePath& dest_file,
+                    const std::string& engines_json) {
+  base::ScopedTempDir staging;
+  if (!staging.CreateUniqueTempDir()) {
+    return false;
+  }
+  const base::FilePath root = staging.GetPath();
+  const base::FilePath out = root.AppendASCII(kSettingsProfileDir);
+  if (!base::CreateDirectory(out)) {
+    return false;
+  }
+  for (const char* file : kSettingsFiles) {
+    const base::FilePath from = profile_dir.AppendASCII(file);
+    if (base::PathExists(from)) {
+      base::CopyFile(from, out.AppendASCII(file));
+    }
+  }
+  // The browser has these folders open. Files it is writing at this moment
+  // may be skipped; the databases are built to be read without them.
+  for (const char* dir : kSettingsDirs) {
+    const base::FilePath from = AppendRelative(profile_dir, dir);
+    if (base::DirectoryExists(from)) {
+      CopyTree(from, AppendRelative(out, dir));
+    }
+  }
+  base::FileEnumerator databases(profile_dir.AppendASCII(kIndexedDBDir),
+                                 /*recursive=*/false,
+                                 base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath database = databases.Next(); !database.empty();
+       database = databases.Next()) {
+    if (database.BaseName().AsUTF8Unsafe().starts_with(
+            kExtensionDatabasePrefix)) {
+      CopyTree(database,
+               out.AppendASCII(kIndexedDBDir).Append(database.BaseName()));
+    }
+  }
+  if (!base::WriteFile(root.AppendASCII(kSettingsMarkerFile),
+                       "{\"product\":\"Yatesium\",\"format\":1}\n")) {
+    return false;
+  }
+  if (!engines_json.empty()) {
+    base::WriteFile(root.AppendASCII(kSettingsEnginesFile), engines_json);
+  }
+  base::DeleteFile(dest_file);
+  return zip::Zip(root, dest_file, /*include_hidden_files=*/true);
+}
+
+struct OpenedFile {
+  bool ok = false;
+  base::FilePath temp_dir;
+  SourceProfile source;
+  bool has_settings = false;
+  std::vector<EngineEntry> engines;
+};
+
+std::vector<EngineEntry> ReadEngines(const base::FilePath& file) {
+  std::vector<EngineEntry> engines;
+  std::optional<base::DictValue> dict = ReadJsonFile(file);
+  const base::ListValue* list = dict ? dict->FindList("engines") : nullptr;
+  if (!list) {
+    return engines;
+  }
+  for (const base::Value& item : *list) {
+    const base::DictValue* engine = item.GetIfDict();
+    if (!engine) {
+      continue;
+    }
+    const std::string* name = engine->FindString("name");
+    const std::string* keyword = engine->FindString("keyword");
+    const std::string* url = engine->FindString("url");
+    if (!name || !keyword || keyword->empty() || !url || url->empty()) {
+      continue;
+    }
+    EngineEntry entry;
+    entry.name = base::UTF8ToUTF16(*name);
+    entry.keyword = base::UTF8ToUTF16(*keyword);
+    entry.url = *url;
+    if (const std::string* suggest_url = engine->FindString("suggest_url")) {
+      entry.suggest_url = *suggest_url;
+    }
+    if (const std::string* favicon_url = engine->FindString("favicon_url")) {
+      entry.favicon_url = *favicon_url;
+    }
+    engines.push_back(std::move(entry));
+  }
+  return engines;
+}
+
+// Unpacks a settings file into a temporary folder and lists what it holds.
+OpenedFile OpenSettingsFile(const base::FilePath& zip_file) {
+  OpenedFile opened;
+  base::FilePath temp_dir;
+  if (!base::CreateNewTempDirectory(FILE_PATH_LITERAL("yatesium_import"),
+                                    &temp_dir)) {
+    return opened;
+  }
+  const base::FilePath profile_dir = temp_dir.AppendASCII(kSettingsProfileDir);
+  if (!zip::Unzip(zip_file, temp_dir) ||
+      !base::PathExists(temp_dir.AppendASCII(kSettingsMarkerFile)) ||
+      !base::DirectoryExists(profile_dir)) {
+    base::DeletePathRecursively(temp_dir);
+    return opened;
+  }
+  opened.ok = true;
+  opened.temp_dir = temp_dir;
+  opened.has_settings = base::PathExists(profile_dir.AppendASCII("Preferences"));
+  opened.source.browser = "Settings file";
+  opened.source.profile_name = zip_file.BaseName().AsUTF8Unsafe();
+  opened.source.profile_dir = profile_dir;
+  opened.source.from_settings_file = true;
+  opened.source.bookmark_count = CountBookmarksInProfile(profile_dir);
+  opened.source.apps = ReadApps(profile_dir);
+  opened.source.extensions = ReadExtensions(profile_dir);
+  opened.engines = ReadEngines(temp_dir.AppendASCII(kSettingsEnginesFile));
+  return opened;
+}
+
+// Puts the unpacked settings file where the next start of the browser finds
+// it. See ApplyPendingRestore().
+bool StageRestore(const base::FilePath& unpacked_profile,
+                  const base::FilePath& profile_dir) {
+  const base::FilePath restore_dir = profile_dir.AppendASCII(kRestoreDirName);
+  base::DeletePathRecursively(restore_dir);
+  if (!base::CreateDirectory(restore_dir)) {
+    return false;
+  }
+  const base::FilePath target = restore_dir.AppendASCII(kSettingsProfileDir);
+  if (!base::Move(unpacked_profile, target) &&
+      !CopyTree(unpacked_profile, target)) {
+    base::DeletePathRecursively(restore_dir);
+    return false;
+  }
+  return base::WriteFile(restore_dir.AppendASCII(kRestoreReadyFile), "1");
+}
+
+// Replaces the parts of one profile that a settings file carries with the
+// staged ones. Parts the file does not have are removed, so the profile ends
+// up matching the file.
+void RestoreProfile(const base::FilePath& profile_dir,
+                    const base::FilePath& source) {
+  for (const char* file : kSettingsFiles) {
+    const base::FilePath target = profile_dir.AppendASCII(file);
+    const base::FilePath from = source.AppendASCII(file);
+    base::DeleteFile(target);
+    if (base::PathExists(from)) {
+      base::Move(from, target);
+    }
+  }
+  for (const char* dir : kSettingsDirs) {
+    const base::FilePath target = AppendRelative(profile_dir, dir);
+    const base::FilePath from = AppendRelative(source, dir);
+    base::DeletePathRecursively(target);
+    if (base::DirectoryExists(from)) {
+      base::CreateDirectory(target.DirName());
+      base::Move(from, target);
+    }
+  }
+  const base::FilePath databases_dir = profile_dir.AppendASCII(kIndexedDBDir);
+  std::vector<base::FilePath> old_databases;
+  {
+    base::FileEnumerator databases(databases_dir, /*recursive=*/false,
+                                   base::FileEnumerator::DIRECTORIES);
+    for (base::FilePath database = databases.Next(); !database.empty();
+         database = databases.Next()) {
+      if (database.BaseName().AsUTF8Unsafe().starts_with(
+              kExtensionDatabasePrefix)) {
+        old_databases.push_back(database);
+      }
+    }
+  }
+  for (const base::FilePath& database : old_databases) {
+    base::DeletePathRecursively(database);
+  }
+  std::vector<base::FilePath> new_databases;
+  {
+    base::FileEnumerator databases(source.AppendASCII(kIndexedDBDir),
+                                   /*recursive=*/false,
+                                   base::FileEnumerator::DIRECTORIES);
+    for (base::FilePath database = databases.Next(); !database.empty();
+         database = databases.Next()) {
+      new_databases.push_back(database);
+    }
+  }
+  for (const base::FilePath& database : new_databases) {
+    base::CreateDirectory(databases_dir);
+    base::Move(database, databases_dir.Append(database.BaseName()));
+  }
+}
+
+// Settings from a settings file, for adding them to the running profile.
+struct SettingsFromFile {
+  std::optional<base::DictValue> preferences;
+  std::optional<base::DictValue> secure_preferences;
+};
+
+SettingsFromFile ReadSettingsFromFile(const base::FilePath& profile_dir) {
+  SettingsFromFile settings;
+  settings.preferences = ReadJsonFile(profile_dir.AppendASCII("Preferences"));
+  settings.secure_preferences =
+      ReadJsonFile(profile_dir.AppendASCII("Secure Preferences"));
+  return settings;
+}
+
+// Sets the settings found in `dict` on the running profile. Only settings
+// that Chromium itself marks as fit to carry from one installation to another
+// (the ones it would sync) are taken; state such as the list of installed
+// extensions is left alone.
+void ApplySyncableSettings(PrefService* prefs,
+                           const base::DictValue& dict,
+                           const std::string& prefix,
+                           int depth) {
+  constexpr uint32_t kSyncable =
+      user_prefs::PrefRegistrySyncable::SYNCABLE_PREF |
+      user_prefs::PrefRegistrySyncable::SYNCABLE_PRIORITY_PREF;
+  for (const auto item : dict) {
+    const std::string path =
+        prefix.empty() ? item.first : prefix + "." + item.first;
+    const PrefService::Preference* pref = prefs->FindPreference(path);
+    if (pref) {
+      if ((pref->registration_flags() & kSyncable) != 0 &&
+          pref->IsUserModifiable() && pref->GetType() == item.second.type()) {
+        prefs->Set(path, item.second);
+      }
+      continue;
+    }
+    if (item.second.is_dict() && depth < 16) {
+      ApplySyncableSettings(prefs, item.second.GetDict(), path, depth + 1);
+    }
+  }
+}
+
+void ApplySettingsFromFile(base::WeakPtr<Profile> profile,
+                           SettingsFromFile settings) {
+  if (!profile) {
+    return;
+  }
+  PrefService* prefs = profile->GetPrefs();
+  if (settings.preferences) {
+    ApplySyncableSettings(prefs, *settings.preferences, std::string(), 0);
+  }
+  if (settings.secure_preferences) {
+    ApplySyncableSettings(prefs, *settings.secure_preferences, std::string(),
+                          0);
+  }
+}
+
+void ImportSettings(Profile* profile, const base::FilePath& from_profile_dir) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&ReadSettingsFromFile, from_profile_dir),
+      base::BindOnce(&ApplySettingsFromFile, profile->GetWeakPtr()));
+}
+
+// Search engines. These run on the UI thread.
+
+// True for a search engine that the user added or turned on, as opposed to
+// the built-in ones and the ones Chromium noted by itself while browsing.
+bool IsCustomEngine(const TemplateURL& engine) {
+  const TemplateURLData& data = engine.data();
+  return engine.type() == TemplateURL::NORMAL && data.prepopulate_id == 0 &&
+         data.starter_pack_id == 0 && !data.CreatedByPolicy() &&
+         !data.safe_for_autoreplace;
+}
+
+// Starts loading the search engines, so they are there when the user clicks.
+void LoadEngines(Profile* profile) {
+  TemplateURLService* service =
+      TemplateURLServiceFactory::GetForProfile(profile);
+  if (service && !service->loaded()) {
+    service->Load();
+  }
+}
+
+// Returns the user's own search engines as JSON for the settings file, or an
+// empty string if they are not available.
+std::string EnginesToJson(Profile* profile) {
+  TemplateURLService* service =
+      TemplateURLServiceFactory::GetForProfile(profile);
+  if (!service || !service->loaded()) {
+    return std::string();
+  }
+  base::ListValue list;
+  for (TemplateURL* engine : service->GetTemplateURLs()) {
+    if (!engine || !IsCustomEngine(*engine)) {
+      continue;
+    }
+    const TemplateURLData& data = engine->data();
+    base::DictValue item;
+    item.Set("name", base::UTF16ToUTF8(data.short_name()));
+    item.Set("keyword", base::UTF16ToUTF8(data.keyword()));
+    item.Set("url", data.url());
+    item.Set("suggest_url", data.suggestions_url);
+    item.Set("favicon_url", data.favicon_url.possibly_invalid_spec());
+    list.Append(std::move(item));
+  }
+  base::DictValue root;
+  root.Set("engines", std::move(list));
+  std::string json;
+  if (!base::JSONWriter::Write(base::Value(std::move(root)), &json)) {
+    return std::string();
+  }
+  return json;
+}
+
+// Adds the search engines to the profile. An engine whose keyword is already
+// taken is skipped. With `replace`, the user's own engines that are there now
+// are removed first, except the one that is the default.
+void AddEngines(Profile* profile,
+                const std::vector<EngineEntry>& engines,
+                bool replace) {
+  TemplateURLService* service =
+      TemplateURLServiceFactory::GetForProfile(profile);
+  if (!service || !service->loaded()) {
+    return;
+  }
+  if (replace) {
+    const TemplateURL* default_engine = service->GetDefaultSearchProvider();
+    std::vector<const TemplateURL*> old_engines;
+    for (TemplateURL* engine : service->GetTemplateURLs()) {
+      if (engine && engine != default_engine && IsCustomEngine(*engine)) {
+        old_engines.push_back(engine);
+      }
+    }
+    for (const TemplateURL* engine : old_engines) {
+      service->Remove(engine);
+    }
+  }
+  for (const EngineEntry& entry : engines) {
+    if (service->GetTemplateURLForKeyword(entry.keyword)) {
+      continue;
+    }
+    TemplateURLData data;
+    data.SetShortName(entry.name);
+    data.SetKeyword(entry.keyword);
+    data.SetURL(entry.url);
+    data.suggestions_url = entry.suggest_url;
+    data.favicon_url = GURL(entry.favicon_url);
+    data.safe_for_autoreplace = false;
+    data.is_active = TemplateURLData::ActiveStatus::kTrue;
+    service->Add(std::make_unique<TemplateURL>(data));
+  }
+}
+
+// Shows a file dialog for a settings file and reports the chosen path, or an
+// empty path if the user cancelled. Deletes itself afterwards.
+class FilePicker : public ui::SelectFileDialog::Listener {
+ public:
+  using Callback = base::OnceCallback<void(const base::FilePath&)>;
+
+  static void Show(bool save, gfx::NativeWindow owner, Callback callback) {
+    FilePicker* picker = new FilePicker(std::move(callback));
+    picker->dialog_ = ui::SelectFileDialog::Create(picker, nullptr);
+    ui::SelectFileDialog::FileTypeInfo::FileExtensionList extensions;
+    extensions.push_back(FILE_PATH_LITERAL("zip"));
+    ui::SelectFileDialog::FileTypeInfo file_types(extensions);
+    picker->dialog_->SelectFile(
+        save ? ui::SelectFileDialog::SELECT_SAVEAS_FILE
+             : ui::SelectFileDialog::SELECT_OPEN_FILE,
+        save ? u"Export Yatesium settings" : u"Import Yatesium settings",
+        save ? base::FilePath(FILE_PATH_LITERAL("Yatesium-settings.zip"))
+             : base::FilePath(),
+        &file_types, 1, FILE_PATH_LITERAL("zip"), owner);
+  }
+
+  FilePicker(const FilePicker&) = delete;
+  FilePicker& operator=(const FilePicker&) = delete;
+  ~FilePicker() override = default;
+
+  // ui::SelectFileDialog::Listener:
+  void FileSelected(const ui::SelectedFileInfo& file, int index) override {
+    Finish(file.file_path);
+  }
+  void FileSelectionCanceled() override { Finish(base::FilePath()); }
+
+ private:
+  explicit FilePicker(Callback callback) : callback_(std::move(callback)) {}
+
+  void Finish(const base::FilePath& path) {
+    if (callback_) {
+      std::move(callback_).Run(path);
+    }
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                               this);
+  }
+
+  Callback callback_;
+  scoped_refptr<ui::SelectFileDialog> dialog_;
+};
