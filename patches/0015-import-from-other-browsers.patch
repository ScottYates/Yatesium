+  // browser stored one.
+  std::optional<std::string> manifest_id_path;
+  // False if the user had set the app to open in a tab.
+  bool opens_in_window = true;
+};
+
+struct ExtensionEntry {
+  std::string id;
+  std::string name;
+  std::string version;
+  // Folder of the installed version in the other browser's profile.
+  base::FilePath dir;
+  // The "key" of its manifest, which fixes the extension's id.
+  std::string key;
+  bool from_web_store = false;
+};
