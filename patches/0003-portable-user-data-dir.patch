+// Yatesium: populates |result| with "<directory of the exe>\Data\User Data".
+bool GetPortableUserDataDirectory(std::wstring* result) {
+  std::wstring exe_path(MAX_PATH, L'\0');
+  for (;;) {
+    DWORD length = ::GetModuleFileNameW(
+        nullptr, &exe_path[0], static_cast<DWORD>(exe_path.size()));
+    if (!length) {
+      return false;
+    }
+    if (length < exe_path.size()) {
+      exe_path.resize(length);
+      break;
+    }
+    if (exe_path.size() >= 32768) {
+      return false;
+    }
+    exe_path.resize(exe_path.size() * 2);
+  }
+  const size_t last_separator = exe_path.find_last_of(L"\\/");
+  if (last_separator == std::wstring::npos) {
+    return false;
+  }
+  exe_path.resize(last_separator);
+  exe_path.append(L"\\Data\\User Data");
+  result->swap(exe_path);
+  return true;
+}
