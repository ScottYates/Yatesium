 namespace {
 
-// Bare bones implementation just checks if a new version is ready.
+#if BUILDFLAG(IS_WIN)
+
+// Yatesium: the About page checks for a new release through the updater that
+// ships next to the browser. The page starts the updater with --now and then
+// follows the state file the updater writes:
+//   checking | uptodate <version> | downloading <version> <percent> |
+//   ready <version> | failed <reason>
+// "ready" means the update is downloaded and is installed when the browser
+// closes; the page then offers to relaunch.
+
+constexpr base::FilePath::CharType kUpdaterExe[] =
+    FILE_PATH_LITERAL("yatesium_update.exe");
+
+// The check gives up if the updater has not finished after this many polls.
+constexpr int kMaxPolls = 900;
+constexpr base::TimeDelta kPollInterval = base::Seconds(2);
+
+base::FilePath InstallDir() {
+  base::FilePath dir;
+  base::PathService::Get(base::DIR_EXE, &dir);
+  return dir;
+}
+
+base::FilePath UpdateDir() {
+  return InstallDir().AppendASCII("Data").AppendASCII("Update");
+}
+
+struct UpdaterState {
+  std::string state;
+  std::string detail;
+};
+
+UpdaterState ReadUpdaterState() {
+  UpdaterState result;
+  std::string text;
+  if (!base::ReadFileToStringWithMaxSize(UpdateDir().AppendASCII("state.txt"),
+                                         &text, 4096)) {
+    return result;
+  }
+  const std::string trimmed(
+      base::TrimWhitespaceASCII(text, base::TRIM_ALL));
+  const size_t space = trimmed.find(' ');
+  if (space == std::string::npos) {
+    result.state = trimmed;
+  } else {
+    result.state = trimmed.substr(0, space);
+    result.detail = trimmed.substr(space + 1);
+  }
+  return result;
+}
+
+// Reads version.txt, which the packaging step writes next to the executable.
+// The first line is the Yatesium version, such as "157.0.8103.79-5". Further
+// lines are "name=value" pairs: "commit" and "built".
+std::vector<std::string> ReadVersionFileLines() {
+  std::string text;
+  if (!base::ReadFileToStringWithMaxSize(
+          InstallDir().AppendASCII("version.txt"), &text, 1024)) {
+    return {};
+  }
+  return base::SplitString(text, "\r\n", base::TRIM_WHITESPACE,
+                           base::SPLIT_WANT_NONEMPTY);
+}
+
+std::string InstalledVersion() {
+  const std::vector<std::string> lines = ReadVersionFileLines();
+  return lines.empty() ? std::string() : lines[0];
+}
+
+// True if a downloaded update is waiting to be installed.
+bool IsUpdateReady(const UpdaterState& state) {
+  return state.state == "ready" && !state.detail.empty() &&
+         state.detail != InstalledVersion();
+}
+
+bool LaunchUpdater() {
+  const base::FilePath updater = InstallDir().Append(kUpdaterExe);
+  if (!base::PathExists(updater)) {
+    return false;
+  }
+  const std::wstring command_line = L"\"" + updater.value() + L"\" --now";
+  base::LaunchOptions options;
+  options.start_hidden = true;
+  return base::LaunchProcess(command_line, options).IsValid();
+}
+
+struct CheckResult {
+  VersionUpdater::Status status = VersionUpdater::DISABLED;
+  int progress = 0;
+  std::string version;
+  std::u16string message;
+  // False while the updater is still working and the state has to be read
+  // again.
+  bool done = true;
+};
+
+// Starts a check. Runs on the thread pool.
+CheckResult StartCheck() {
+  CheckResult result;
+  if (!base::PathExists(InstallDir().Append(kUpdaterExe))) {
+    return result;
+  }
+  const UpdaterState state = ReadUpdaterState();
+  if (IsUpdateReady(state)) {
+    result.status = VersionUpdater::NEARLY_UPDATED;
+    result.version = state.detail;
+    return result;
+  }
+  base::DeleteFile(UpdateDir().AppendASCII("state.txt"));
+  if (!LaunchUpdater()) {
+    result.status = VersionUpdater::FAILED;
+    result.message = u"The updater could not be started.";
+    return result;
+  }
+  result.status = VersionUpdater::CHECKING;
+  result.done = false;
+  return result;
+}
+
+// Reads how far the updater has got. Runs on the thread pool.
+CheckResult PollCheck() {
+  CheckResult result;
+  result.status = VersionUpdater::CHECKING;
+  result.done = false;
+  const UpdaterState state = ReadUpdaterState();
+  if (state.state == "uptodate") {
+    result.status = VersionUpdater::UPDATED;
+    result.done = true;
+  } else if (state.state == "downloading") {
+    result.status = VersionUpdater::UPDATING;
+    const size_t space = state.detail.find(' ');
+    if (space != std::string::npos) {
+      result.version = state.detail.substr(0, space);
+      int percent = 0;
+      if (base::StringToInt(state.detail.substr(space + 1), &percent)) {
+        result.progress = percent;
+      }
+    }
+  } else if (state.state == "ready") {
+    result.status = VersionUpdater::NEARLY_UPDATED;
+    result.version = state.detail;
+    result.done = true;
+  } else if (state.state == "failed") {
+    result.status = VersionUpdater::FAILED;
+    result.message = base::UTF8ToUTF16(state.detail);
+    result.done = true;
+  }
+  return result;
+}
+
+class YatesiumVersionUpdater : public VersionUpdater {
+ public:
+  YatesiumVersionUpdater() = default;
+  YatesiumVersionUpdater(const YatesiumVersionUpdater&) = delete;
+  YatesiumVersionUpdater& operator=(const YatesiumVersionUpdater&) = delete;
+  ~YatesiumVersionUpdater() override = default;
+
+  // VersionUpdater implementation.
+  void CheckForUpdate(StatusCallback callback, PromoteCallback) override {
+    callback_ = std::move(callback);
+    polls_ = 0;
+    timer_.Stop();
+    weak_factory_.InvalidateWeakPtrs();
+    callback_.Run(CHECKING, 0, false, false, std::string(), 0,
+                  std::u16string());
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&StartCheck),
+        base::BindOnce(&YatesiumVersionUpdater::OnResult,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+ private:
+  void OnResult(CheckResult result) {
+    callback_.Run(result.status, result.progress, false, false, result.version,
+                  0, result.message);
+    if (result.done) {
+      return;
+    }
+    if (++polls_ > kMaxPolls) {
+      callback_.Run(FAILED, 0, false, false, std::string(), 0,
+                    u"The update check did not finish.");
+      return;
+    }
+    timer_.Start(FROM_HERE, kPollInterval,
+                 base::BindOnce(&YatesiumVersionUpdater::Poll,
+                                base::Unretained(this)));
+  }
+
+  void Poll() {
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&PollCheck),
+        base::BindOnce(&YatesiumVersionUpdater::OnResult,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+  StatusCallback callback_;
+  int polls_ = 0;
+  // Owned by this object, so its task cannot outlive it.
+  base::OneShotTimer timer_;
+  base::WeakPtrFactory<YatesiumVersionUpdater> weak_factory_{this};
+};
+
+#else  // BUILDFLAG(IS_WIN)
+
 class VersionUpdaterBasic : public VersionUpdater {
  public:
   VersionUpdaterBasic(const VersionUpdaterBasic&) = delete;
@@ -27,9 +256,60 @@ class VersionUpdaterBasic : public VersionUpdater {
   }
 };
 
+#endif  // BUILDFLAG(IS_WIN)
+
 }  // namespace
 
+#if BUILDFLAG(IS_WIN)
+namespace yatesium {
+
+bool PrepareUpdateRelaunch() {
+  if (!IsUpdateReady(ReadUpdaterState())) {
+    return false;
+  }
+  const base::FilePath request = UpdateDir().AppendASCII("relaunch");
+  if (!base::WriteFile(request, "1")) {
+    return false;
+  }
+  // An updater is normally already waiting for the browser to close. One more
+  // is started in case it is not; it steps aside if the other one is there.
+  if (!LaunchUpdater()) {
+    base::DeleteFile(request);
+    return false;
+  }
+  return true;
+}
+
+std::u16string GetBuildInfoForUi() {
+  const std::vector<std::string> lines = ReadVersionFileLines();
+  if (lines.empty()) {
+    return std::u16string();
+  }
+  std::string info = "Yatesium build " + lines[0];
+  for (size_t i = 1; i < lines.size(); ++i) {
+    const size_t equals = lines[i].find('=');
+    if (equals == std::string::npos) {
+      continue;
+    }
+    const std::string name = lines[i].substr(0, equals);
+    const std::string value = lines[i].substr(equals + 1);
+    if (name == "commit" && !value.empty()) {
+      info += ", commit " + value;
+    } else if (name == "built" && !value.empty()) {
+      info += ", built " + value;
+    }
+  }
+  return base::UTF8ToUTF16(info);
+}
+
+}  // namespace yatesium
+#endif  // BUILDFLAG(IS_WIN)
+
 std::unique_ptr<VersionUpdater> VersionUpdater::Create(
     content::WebContents* web_contents) {
+#if BUILDFLAG(IS_WIN)
+  return std::make_unique<YatesiumVersionUpdater>();
+#else
   return std::make_unique<VersionUpdaterBasic>();
+#endif
 }
