+#if BUILDFLAG(IS_WIN)
+// Yatesium: if an update has been downloaded, the relaunch buttons finish it.
+// The browser closes, the updater installs the update and starts the browser
+// again. Otherwise they relaunch as usual.
+void FinishRelaunch(bool restart, bool update_is_ready) {
+  if (update_is_ready) {
+    chrome::AttemptExit();
+  } else if (restart) {
+    chrome::AttemptRestart();
+  } else {
+    chrome::AttemptRelaunch();
+  }
+}
+
+void RelaunchOrInstallUpdate(bool restart) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(&yatesium::PrepareUpdateRelaunch),
+      base::BindOnce(&FinishRelaunch, restart));
+}
+#endif  // BUILDFLAG(IS_WIN)
+
 }  // namespace
 
