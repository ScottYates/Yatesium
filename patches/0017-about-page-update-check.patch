@@ -0,0 +1,25 @@
+// Yatesium: what the About page and the relaunch button need from the
+// updater that ships next to the browser (yatesium_update.exe).
+
+#ifndef CHROME_BROWSER_UI_WEBUI_HELP_YATESIUM_UPDATE_H_
+#define CHROME_BROWSER_UI_WEBUI_HELP_YATESIUM_UPDATE_H_
+
+#include <string>
+
+namespace yatesium {
+
+// Returns the Yatesium build for the About page, such as "Yatesium build
+// 157.0.8103.79-5, commit 1a2b3c4, built 2026-11-14", or an empty string if
+// the build information file is not there. Reads a small file.
+std::u16string GetBuildInfoForUi();
+
+// If an update has been downloaded and is waiting for the browser to close,
+// asks the updater to start the browser again once the update is installed,
+// and returns true. The caller then closes the browser instead of relaunching
+// it. Returns false if no update is waiting. Does file access: call it on a
+// thread that may block.
+bool PrepareUpdateRelaunch();
+
+}  // namespace yatesium
+
+#endif  // CHROME_BROWSER_UI_WEBUI_HELP_YATESIUM_UPDATE_H_
