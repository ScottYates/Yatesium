 namespace flags_ui {
 
+namespace {
+
+// Yatesium: the values of these flags are secrets. They are stored encrypted
+// with Windows data protection (DPAPI), which ties them to the Windows
+// account on this computer. Stored form: this prefix, then the hex blob.
+constexpr char kProtectedPrefix[] = "dpapi:";
+
+bool IsProtectedFlag(std::string_view internal_entry_name) {
+  return internal_entry_name == "google-api-key" ||
+         internal_entry_name == "google-oauth-client-id" ||
+         internal_entry_name == "google-oauth-client-secret";
+}
+
+#if BUILDFLAG(IS_WIN)
+// Returns an empty string if the value is empty or cannot be encrypted, so a
+// secret is never written in the clear.
+std::string ProtectValue(const std::string& plain) {
+  if (plain.empty()) {
+    return std::string();
+  }
+  DATA_BLOB input;
+  input.pbData =
+      const_cast<BYTE*>(reinterpret_cast<const BYTE*>(plain.data()));
+  input.cbData = static_cast<DWORD>(plain.size());
+  DATA_BLOB output = {};
+  if (!::CryptProtectData(&input, L"Yatesium", nullptr, nullptr, nullptr,
+                          CRYPTPROTECT_UI_FORBIDDEN, &output)) {
+    return std::string();
+  }
+  const std::string blob(reinterpret_cast<const char*>(output.pbData),
+                         output.cbData);
+  ::LocalFree(output.pbData);
+  return kProtectedPrefix + base::HexEncode(blob);
+}
+
+// Returns an empty string for anything that is not a value this account on
+// this computer encrypted.
+std::string UnprotectValue(const std::string& stored) {
+  const std::string_view prefix(kProtectedPrefix);
+  if (stored.size() <= prefix.size() ||
+      std::string_view(stored).substr(0, prefix.size()) != prefix) {
+    return std::string();
+  }
+  std::string blob;
+  if (!base::HexStringToString(std::string_view(stored).substr(prefix.size()),
+                               &blob) ||
+      blob.empty()) {
+    return std::string();
+  }
+  DATA_BLOB input;
+  input.pbData = reinterpret_cast<BYTE*>(blob.data());
+  input.cbData = static_cast<DWORD>(blob.size());
+  DATA_BLOB output = {};
+  if (!::CryptUnprotectData(&input, nullptr, nullptr, nullptr, nullptr,
+                            CRYPTPROTECT_UI_FORBIDDEN, &output)) {
+    return std::string();
+  }
+  std::string plain(reinterpret_cast<const char*>(output.pbData),
+                    output.cbData);
+  ::SecureZeroMemory(output.pbData, output.cbData);
+  ::LocalFree(output.pbData);
+  return plain;
+}
+#endif  // BUILDFLAG(IS_WIN)
+
+}  // namespace
