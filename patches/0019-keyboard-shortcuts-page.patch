+}
+)css";
+
+// The script of the page. Served as "shortcuts.js". It builds the list from
+// the state it is given and never sets HTML from text.
+constexpr char kScript[] = R"js(
+(function() {
+  'use strict';
+
+  const token = document.body.dataset.token;
+  const list = document.getElementById('list');
+  const filter = document.getElementById('filter');
+  const notice = document.getElementById('notice');
+  const resetAll = document.getElementById('reset-all');
+
+  // What the browser last reported.
+  let state = null;
+  // Name of the command whose new shortcut is being recorded.
+  let recording = null;
+  // {id, k, text, owner}: a shortcut that another command has, waiting for
+  // the user to decide.
+  let conflict = null;
+  // {id, text}: why the last change to a command was refused.
+  let refusal = null;
+  let confirmingResetAll = false;
+  let waiting = false;
+
+  function element(tag, className, text) {
+    const node = document.createElement(tag);
+    if (className) {
+      node.className = className;
+    }
+    if (text) {
+      node.textContent = text;
+    }
+    return node;
+  }
+
+  function button(className, text, label, onClick) {
+    const node = element('button', className, text);
+    node.type = 'button';
+    if (label) {
+      node.setAttribute('aria-label', label);
+    }
+    node.addEventListener('click', onClick);
+    return node;
+  }
+
+  function focusById(id) {
+    const node = document.getElementById(id);
+    if (node) {
+      node.focus();
+    }
+  }
+
+  function showNotice(text) {
+    notice.textContent = text;
+    notice.hidden = !text;
+  }
+
+  // Sends one request to the browser. `done` gets the parsed answer.
+  // XMLHttpRequest is used because pages on the browser's own address may
+  // not use fetch().
+  function send(path, params, done) {
+    if (waiting) {
+      return;
+    }
+    waiting = true;
+    let query = 't=' + encodeURIComponent(token) + '&n=' + Date.now();
+    Object.keys(params).forEach(function(key) {
+      query += '&' + key + '=' + encodeURIComponent(params[key]);
+    });
+    function fail() {
+      waiting = false;
+      showNotice('The browser did not answer. Reload this page.');
+      render();
+    }
+    const request = new XMLHttpRequest();
+    request.open('GET', path + '?' + query);
+    request.onload = function() {
+      let data = null;
+      try {
+        data = JSON.parse(request.responseText);
+      } catch (error) {
+        fail();
+        return;
+      }
+      waiting = false;
+      if (!data || !data.state) {
+        showNotice(
+            data && data.message ? data.message :
+                                   'The browser did not answer. Reload this ' +
+                                       'page.');
+        render();
+        return;
+      }
+      showNotice('');
+      state = data.state;
+      done(data);
+    };
+    request.onerror = fail;
+    request.ontimeout = fail;
+    request.timeout = 5000;
+    try {
+      request.send();
+    } catch (error) {
+      fail();
+    }
+  }
+
+  function clearRowState() {
+    recording = null;
+    conflict = null;
+    refusal = null;
+    confirmingResetAll = false;
+  }
+
+  function startRecording(id) {
+    clearRowState();
+    recording = id;
+    render();
+    focusById('capture');
+  }
+
+  function stopRecording(id) {
+    if (recording !== id) {
+      return;
+    }
+    recording = null;
+    render();
+    focusById('add-' + id);
+  }
+
+  function addShortcut(id, k, takeOver) {
+    clearRowState();
+    send('add', {c: id, k: k, f: takeOver ? 1 : 0}, function(data) {
+      if (data.status === 'conflict') {
+        conflict = {id: id, k: data.k, text: data.text, owner: data.owner};
+      } else if (data.status === 'error') {
+        refusal = {id: id, text: data.message};
+      }
+      render();
+      focusById(conflict ? 'take-over' : 'add-' + id);
+    });
+  }
+
+  function removeShortcut(id, k) {
+    clearRowState();
+    send('remove', {c: id, k: k}, function() {
+      render();
+      focusById('add-' + id);
+    });
+  }
+
+  function resetCommand(id) {
+    clearRowState();
+    send('reset', {c: id}, function() {
+      render();
+      focusById('add-' + id);
+    });
+  }
+
+  function buildAddButton(command) {
+    const add = button(
+        'button small', 'Add', 'Add a shortcut for ' + command.label,
+        function() {
+          startRecording(command.id);
+        });
+    add.id = 'add-' + command.id;
+    return add;
+  }
+
+  function buildRow(command) {
+    const row = element('div', 'row');
+    const name = element('div', 'name', command.label);
+    if (command.changed) {
+      name.appendChild(element('span', 'tag', 'Changed'));
+    }
+    row.appendChild(name);
+
+    const keys = element('div', 'keys');
+    command.shortcuts.forEach(function(shortcut) {
+      const chip = element('span', 'chip');
+      chip.appendChild(element('kbd', '', shortcut.text));
+      const remove = button(
+          'remove', '×',
+          'Remove ' + shortcut.text + ' from ' + command.label, function() {
+            removeShortcut(command.id, shortcut.k);
+          });
+      remove.title = 'Remove';
+      chip.appendChild(remove);
+      keys.appendChild(chip);
+    });
+    if (!command.shortcuts.length) {
+      keys.appendChild(element('span', 'muted', 'No shortcut'));
+    }
+    if (recording === command.id) {
+      const capture = button(
+          'capture', 'Press the new shortcut. Esc cancels.', '', function() {});
+      capture.id = 'capture';
+      // Leaving the box ends the recording. Only the box is replaced, so
+      // that a click on another control still reaches that control.
+      capture.addEventListener('blur', function() {
+        if (recording === command.id) {
+          recording = null;
+          capture.replaceWith(buildAddButton(command));
+        }
+      });
+      keys.appendChild(capture);
+    } else {
+      keys.appendChild(buildAddButton(command));
+    }
+    if (command.custom) {
+      keys.appendChild(button(
+          'button small', 'Reset',
+          'Reset the shortcuts of ' + command.label, function() {
+            resetCommand(command.id);
+          }));
+    }
+    row.appendChild(keys);
+
+    command.lost.forEach(function(lost) {
+      row.appendChild(element(
+          'div', 'note muted', lost.text + ' is now used by ' + lost.by + '.'));
+    });
+    if (refusal && refusal.id === command.id) {
+      const note = element('div', 'note error', refusal.text);
+      note.setAttribute('role', 'alert');
+      row.appendChild(note);
+    }
+    if (conflict && conflict.id === command.id) {
+      const note = element(
+          'div', 'note',
+          conflict.text + ' is used by ' + conflict.owner + '. ');
+      note.setAttribute('role', 'alert');
+      const takeOver = button('button small', 'Move it here', '', function() {
+        addShortcut(command.id, conflict.k, true);
+      });
+      takeOver.id = 'take-over';
+      note.appendChild(takeOver);
+      note.appendChild(button('button small', 'Cancel', '', function() {
+        conflict = null;
+        render();
+        focusById('add-' + command.id);
+      }));
+      row.appendChild(note);
+    }
+    return row;
+  }
+
+  function matches(command, words) {
+    if (!words) {
+      return true;
+    }
+    let text = command.label;
+    command.shortcuts.forEach(function(shortcut) {
+      text += ' ' + shortcut.text;
+    });
+    return text.toLowerCase().indexOf(words) !== -1;
+  }
+
+  function render() {
+    if (!state) {
+      return;
+    }
+    const words = filter.value.trim().toLowerCase();
+    list.textContent = '';
+    let shown = 0;
+    state.sections.forEach(function(section) {
+      const commands = section.commands.filter(function(command) {
+        return matches(command, words);
+      });
+      if (!commands.length) {
+        return;
+      }
+      shown += commands.length;
+      const card = element('section', 'card');
+      card.appendChild(element('h2', '', section.title));
+      commands.forEach(function(command) {
+        card.appendChild(buildRow(command));
+      });
+      list.appendChild(card);
+    });
+    if (!shown) {
+      list.appendChild(element('p', 'muted', 'No command matches.'));
+    }
+
+    resetAll.disabled = !state.custom;
+    const confirm = document.getElementById('confirm-reset');
+    confirm.hidden = !confirmingResetAll;
+  }
+
+  function loadState() {
+    send('state.json', {}, function() {
+      render();
+    });
+  }
+
+  // While a shortcut is being recorded, every key press belongs to the
+  // recording and none reaches the browser.
+  document.addEventListener('keydown', function(event) {
+    if (!recording) {
+      return;
+    }
+    event.preventDefault();
+    event.stopPropagation();
+    if (event.repeat) {
+      return;
+    }
+    const key = event.keyCode;
+    // Shift, Ctrl, Alt and the Windows keys on their own, and keys that an
+    // input method is handling.
+    if (!key || key === 16 || key === 17 || key === 18 || key === 91 ||
+        key === 92 || key === 229) {
+      return;
+    }
+    const id = recording;
+    const modifiers = (event.ctrlKey ? 1 : 0) | (event.shiftKey ? 2 : 0) |
+        (event.altKey ? 4 : 0);
+    if (key === 27 && !modifiers) {
+      stopRecording(id);
+      return;
+    }
+    if (event.metaKey || event.getModifierState('AltGraph')) {
+      clearRowState();
+      refusal = {
+        id: id,
+        text: 'The Windows key and AltGr cannot be used in a shortcut.',
+      };
+      render();
+      focusById('add-' + id);
+      return;
+    }
+    addShortcut(id, (modifiers << 8) | key, false);
+  }, true);
+
+  filter.addEventListener('input', function() {
+    clearRowState();
+    render();
+  });
+
+  resetAll.addEventListener('click', function() {
+    clearRowState();
+    confirmingResetAll = true;
+    render();
+    focusById('confirm-reset-yes');
+  });
+
+  document.getElementById('confirm-reset-yes')
+      .addEventListener('click', function() {
+        clearRowState();
+        send('resetall', {}, function() {
+          render();
+          filter.focus();
+        });
+      });
+
+  document.getElementById('confirm-reset-no')
+      .addEventListener('click', function() {
+        clearRowState();
+        render();
+        resetAll.focus();
+      });
+
+  // Another tab of this page may have changed the shortcuts.
+  document.addEventListener('visibilitychange', function() {
+    if (!document.hidden && !recording && !conflict) {
+      loadState();
+    }
+  });
+
+  loadState();
+})();
+)js";
+
+// The page, up to the token.
+constexpr char kPageStart[] =
+    "<!doctype html>"
+    "<html lang=\"en\">"
+    "<head>"
+    "<meta charset=\"utf-8\">"
+    "<meta name=\"color-scheme\" content=\"light dark\">"
+    "<title>"
+    "Keyboard shortcuts</title>"
+    "<link rel=\"stylesheet\" href=\"style.css\">"
+    "</head>"
+    "<body data-token=\"";
+
+// The page, after the token.
+constexpr char kPageEnd[] =
+    "\">"
+    "<main>"
+    "<h1>"
+    "Keyboard shortcuts</h1>"
+    "<p class=\"muted\">"
+    "A change applies at once, in every window. Choose \"Add\" and "
+    "press the keys of the new shortcut. A command can have "
+    "several shortcuts.</p>"
+    "<div class=\"bar\">"
+    "<input id=\"filter\" type=\"search\" placeholder=\"Search "
+    "commands and shortcuts\" aria-label=\"Search commands and "
+    "shortcuts\">"
+    "<button id=\"reset-all\" class=\"button\" type=\"button\" "
+    "disabled>"
+    "Reset all</button>"
+    "</div>"
+    "<p id=\"confirm-reset\" class=\"card\" hidden>"
+    "Give every command its original shortcuts back? <button "
+    "id=\"confirm-reset-yes\" class=\"button danger\" type=\"button\">"
+    "Reset all</button>"
+    " <button id=\"confirm-reset-no\" class=\"button\" type=\"button\">"
+    "Cancel</button>"
+    "</p>"
+    "<p id=\"notice\" class=\"error\" role=\"alert\" hidden>"
+    "</p>"
+    "<div id=\"list\">"
+    "</div>"
+    "</main>"
+    "<script src=\"shortcuts.js\">"
+    "</script>"
+    "</body>"
+    "</html>";
+
+// Requests that change something must carry this token. The page gets it
+// when it is built. It keeps a link or a typed address from changing a
+// shortcut.
+const std::string& PageToken() {
+  static const base::NoDestructor<std::string> token(
+      base::UnguessableToken::Create().ToString());
+  return *token;
+}
+
+constexpr char kStaleJson[] =
+    "{\"message\":\"This page is out of date. Reload it.\"}";
+
+// Answers "state.json" and the requests that change a shortcut.
+std::string HandleRequest(const std::string& path, const GURL& url) {
+  // Makes sure the list has been built, which fills DefaultBindings().
+  GetAcceleratorList();
+  const std::vector<ShortcutBinding>& defaults = DefaultBindings();
+  ShortcutOverrides overrides = LoadOverrides();
+  if (path == "/state.json") {
+    return ShortcutResponseJson(ShortcutChange(), 0, defaults, overrides);
+  }
+
+  std::string token;
+  std::string command_name;
+  int shortcut = 0;
+  bool take_over = false;
+  for (net::QueryIterator it(url); !it.IsAtEnd(); it.Advance()) {
+    const std::string key(it.GetKey());
+    const std::string value(it.GetUnescapedValue());
+    if (key == "t") {
+      token = value;
+    } else if (key == "c") {
+      command_name = value;
+    } else if (key == "k") {
+      if (!base::StringToInt(value, &shortcut)) {
+        shortcut = 0;
+      }
+    } else if (key == "f") {
+      take_over = value == "1";
+    }
+  }
+  if (token != PageToken()) {
+    return kStaleJson;
+  }
+
+  const ShortcutOverrides before = overrides;
+  const ShortcutCommand* command = FindShortcutCommand(command_name);
+  ShortcutChange change;
+  if (path == "/resetall") {
+    overrides.clear();
+  } else if (!command) {
+    change.result = ShortcutResult::kError;
+    change.message = "This command is not known.";
+  } else if (path == "/add") {
+    change =
+        AddShortcut(defaults, &overrides, command->id, shortcut, take_over);
+  } else if (path == "/remove") {
+    RemoveShortcut(defaults, &overrides, command->id, shortcut);
+  } else if (path == "/reset") {
+    ResetShortcuts(&overrides, command->id);
+  }
+
+  if (overrides != before) {
+    SaveOverrides(overrides);
+    // Every browser window loads the new list during this call.
+    ReloadAcceleratorList();
+  }
+  return ShortcutResponseJson(change, shortcut, defaults, overrides);
+}
+
+bool IsRequestPath(const std::string& path) {
+  return path == "/state.json" || path == "/add" || path == "/remove" ||
+         path == "/reset" || path == "/resetall";
+}
+
+class ShortcutsSource : public content::URLDataSource {
+ public:
+  ShortcutsSource() = default;
+  ShortcutsSource(const ShortcutsSource&) = delete;
+  ShortcutsSource& operator=(const ShortcutsSource&) = delete;
+  ~ShortcutsSource() override = default;
+
+  // content::URLDataSource:
+  std::string GetSource() override { return kShortcutsHost; }
+
+  void StartDataRequest(
+      const GURL& url,
+      const content::WebContents::Getter& wc_getter,
+      content::URLDataSource::GotDataCallback callback) override {
+    const std::string path(url.path());
+    std::string body;
+    if (path == "/style.css") {
+      body = kStyleSheet;
+    } else if (path == "/shortcuts.js") {
+      body = kScript;
+    } else if (IsRequestPath(path)) {
+      body = HandleRequest(path, url);
+    } else {
+      body = std::string(kPageStart) + PageToken() + kPageEnd;
+    }
+    std::move(callback).Run(
+        base::MakeRefCounted<base::RefCountedString>(std::move(body)));
+  }
+
+  std::string GetMimeType(const GURL& url) override {
+    const std::string path(url.path());
+    if (path == "/style.css") {
+      return "text/css";
+    }
+    if (path == "/shortcuts.js") {
+      return "text/javascript";
+    }
+    if (IsRequestPath(path)) {
+      return "application/json";
+    }
+    return "text/html";
+  }
+
+  bool AllowCaching() override { return false; }
+};
+
+}  // namespace
+
+void RegisterShortcutPrefs(PrefRegistrySimple* registry) {
+  registry->RegisterDictionaryPref(kShortcutsPref);
+}
+
+void InitShortcuts() {
+  SetAcceleratorListFilter(base::BindRepeating(&FilterAcceleratorList));
+}
+
+std::string ExportShortcutsJson() {
+  base::DictValue root;
+  root.Set("format", 1);
+  root.Set(kJsonShortcutsKey, OverridesToDict(LoadOverrides()));
+  std::string json;
+  if (!base::JSONWriter::Write(base::Value(std::move(root)), &json)) {
+    return std::string();
+  }
+  return json;
+}
+
+int CountShortcutsInJson(const std::string& json) {
+  std::optional<ShortcutOverrides> overrides = OverridesFromJson(json);
+  return overrides ? static_cast<int>(overrides->size()) : -1;
+}
+
+bool ImportShortcutsJson(const std::string& json, bool replace) {
+  std::optional<ShortcutOverrides> incoming = OverridesFromJson(json);
+  if (!incoming) {
+    return false;
+  }
+  // Makes sure the list has been built, which fills DefaultBindings().
+  GetAcceleratorList();
+  const ShortcutOverrides before = LoadOverrides();
+  ShortcutOverrides overrides;
+  if (!replace) {
+    overrides = before;
+  }
+  MergeShortcutOverrides(DefaultBindings(), &overrides, *incoming);
+  if (overrides != before) {
+    SaveOverrides(overrides);
+    ReloadAcceleratorList();
+  }
+  return true;
+}
+
+bool IsShortcutsPage(content::WebContents* contents) {
+  if (!contents) {
+    return false;
+  }
+  const GURL& url = contents->GetLastCommittedURL();
+  return url.SchemeIs(content::kChromeUIScheme) && url.host() == kShortcutsHost;
+}
+
+ShortcutsUI::ShortcutsUI(content::WebUI* web_ui) : WebUIController(web_ui) {
+  content::URLDataSource::Add(Profile::FromWebUI(web_ui),
+                              std::make_unique<ShortcutsSource>());
+}
+
+ShortcutsUI::~ShortcutsUI() = default;
+
+ShortcutsUIConfig::ShortcutsUIConfig()
+    : DefaultWebUIConfig(content::kChromeUIScheme, kShortcutsHost) {}
+
+}  // namespace yatesium
