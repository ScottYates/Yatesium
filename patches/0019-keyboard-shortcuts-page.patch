+// Windows virtual key codes that have no letter or digit.
+constexpr int kKeyBackspace = 0x08;
+constexpr int kKeyTab = 0x09;
+constexpr int kKeyEnter = 0x0D;
+constexpr int kKeyAlt = 0x12;
+constexpr int kKeyEscape = 0x1B;
+constexpr int kKeySpace = 0x20;
+constexpr int kKeyPageUp = 0x21;
+constexpr int kKeyPageDown = 0x22;
+constexpr int kKeyEnd = 0x23;
+constexpr int kKeyHome = 0x24;
+constexpr int kKeyLeft = 0x25;
+constexpr int kKeyUp = 0x26;
+constexpr int kKeyRight = 0x27;
+constexpr int kKeyDown = 0x28;
+constexpr int kKeyInsert = 0x2D;
+constexpr int kKeyDelete = 0x2E;
+constexpr int kKeyNumpad0 = 0x60;
+constexpr int kKeyNumpad9 = 0x69;
+constexpr int kKeyF1 = 0x70;
+constexpr int kKeyF24 = 0x87;
+constexpr int kKeyLeftAlt = 0xA4;
+constexpr int kKeyRightAlt = 0xA5;
+constexpr int kKeyBrowserSearch = 0xAA;
+
+struct KeyName {
+  int key;
+  const char* name;
+  // False for a key that Chromium uses in a shortcut but the page does not
+  // accept in a new one.
+  bool can_assign;
+};
+
+constexpr KeyName kKeyNames[] = {
+    {kKeyBackspace, "Backspace", true},
+    {kKeyTab, "Tab", true},
+    {kKeyEnter, "Enter", true},
+    {kKeyAlt, "Alt", false},
+    {kKeyEscape, "Esc", true},
+    {kKeySpace, "Space", true},
+    {kKeyPageUp, "Page Up", true},
+    {kKeyPageDown, "Page Down", true},
+    {kKeyEnd, "End", true},
+    {kKeyHome, "Home", true},
+    {kKeyLeft, "Left", true},
+    {kKeyUp, "Up", true},
+    {kKeyRight, "Right", true},
+    {kKeyDown, "Down", true},
+    {kKeyInsert, "Insert", true},
+    {kKeyDelete, "Delete", true},
+    {0x6A, "Numpad *", true},
+    {0x6B, "Numpad Plus", true},
+    {0x6D, "Numpad Minus", true},
+    {0x6E, "Numpad .", true},
+    {0x6F, "Numpad /", true},
+    {kKeyLeftAlt, "Left Alt", false},
+    {kKeyRightAlt, "Right Alt", false},
+    {kKeyBrowserSearch, "Search key", false},
+    // The names of these are those of the US keyboard layout.
+    {0xBA, ";", true},
+    {0xBB, "Plus", true},
+    {0xBC, ",", true},
+    {0xBD, "Minus", true},
+    {0xBE, ".", true},
+    {0xBF, "/", true},
+    {0xC0, "`", true},
+    {0xDB, "[", true},
+    {0xDC, "\\", true},
+    {0xDD, "]", true},
+    {0xDE, "'", true},
+};
+
+bool IsLetterOrDigit(int key) {
+  return (key >= 'A' && key <= 'Z') || (key >= '0' && key <= '9');
+}
+
+bool IsFunctionKey(int key) {
+  return key >= kKeyF1 && key <= kKeyF24;
+}
+
+bool IsNumpadDigit(int key) {
+  return key >= kKeyNumpad0 && key <= kKeyNumpad9;
+}
+
+const KeyName* FindKeyName(int key) {
+  for (const KeyName& entry : kKeyNames) {
+    if (entry.key == key) {
+      return &entry;
+    }
+  }
+  return nullptr;
+}
+
+std::string KeyText(int key) {
+  if (IsLetterOrDigit(key)) {
+    return std::string(1, static_cast<char>(key));
+  }
+  if (IsFunctionKey(key)) {
+    return "F" + std::to_string(key - kKeyF1 + 1);
+  }
+  if (IsNumpadDigit(key)) {
+    return "Numpad " + std::to_string(key - kKeyNumpad0);
+  }
+  if (const KeyName* entry = FindKeyName(key)) {
+    return entry->name;
+  }
+  return "Key " + std::to_string(key);
+}
+
+bool CanAssignKey(int key) {
+  if (IsLetterOrDigit(key) || IsFunctionKey(key) || IsNumpadDigit(key)) {
+    return true;
+  }
+  const KeyName* entry = FindKeyName(key);
+  return entry && entry->can_assign;
+}
+
+// True for the shortcuts of text fields: copy and paste, undo, select all,
+// and moving or deleting by word. A browser command on one of these would
+// take the key away from the text field.
+bool IsEditingShortcut(int shortcut) {
+  const int key = ShortcutKey(shortcut);
+  const int modifiers = ShortcutModifiers(shortcut);
+  if (modifiers == kShortcutCtrl) {
+    switch (key) {
+      case 'A':
+      case 'C':
+      case 'V':
+      case 'X':
+      case 'Y':
+      case 'Z':
+      case kKeyBackspace:
+      case kKeyDelete:
+      case kKeyInsert:
+        return true;
+    }
+  }
+  if (modifiers == (kShortcutCtrl | kShortcutShift) &&
+      (key == 'V' || key == 'Z')) {
+    return true;
+  }
+  if (modifiers == kShortcutCtrl ||
+      modifiers == (kShortcutCtrl | kShortcutShift)) {
+    switch (key) {
+      case kKeyLeft:
+      case kKeyRight:
+      case kKeyUp:
+      case kKeyDown:
+      case kKeyHome:
+      case kKeyEnd:
+        return true;
+    }
+  }
+  return false;
+}
+
+// True for the shortcuts Windows handles before the browser sees them.
+bool IsWindowsShortcut(int shortcut) {
+  const int key = ShortcutKey(shortcut);
+  const int modifiers = ShortcutModifiers(shortcut);
+  if (modifiers == kShortcutAlt ||
+      modifiers == (kShortcutAlt | kShortcutShift)) {
+    return key == kKeyTab || key == kKeyEscape || key == kKeySpace;
+  }
+  if (modifiers == kShortcutCtrl ||
+      modifiers == (kShortcutCtrl | kShortcutShift)) {
+    return key == kKeyEscape;
+  }
+  if (modifiers == (kShortcutCtrl | kShortcutAlt)) {
+    return key == kKeyDelete;
+  }
+  return false;
+}
+
+std::vector<int> DefaultsOf(const std::vector<ShortcutBinding>& defaults,
+                            int command_id) {
+  std::vector<int> result;
+  for (const ShortcutBinding& binding : defaults) {
+    if (binding.command_id == command_id) {
+      result.push_back(binding.shortcut);
+    }
+  }
+  return result;
+}
+
+// The command the user gave `shortcut` to, or nullptr.
+const ShortcutCommand* UserOwner(const ShortcutOverrides& overrides,
+                                 int shortcut) {
+  for (const auto& [command_id, shortcuts] : overrides) {
+    for (int entry : shortcuts) {
+      if (entry == shortcut) {
+        return FindShortcutCommandById(command_id);
+      }
+    }
+  }
+  return nullptr;
+}
+
+// The shortcuts `command_id` has now.
+std::vector<int> CurrentOf(const std::vector<ShortcutBinding>& defaults,
+                           const ShortcutOverrides& overrides,
+                           int command_id) {
+  std::vector<int> result;
+  for (const ShortcutBinding& binding :
+       EffectiveShortcuts(defaults, overrides)) {
+    if (binding.command_id == command_id) {
+      result.push_back(binding.shortcut);
+    }
+  }
+  return result;
+}
+
+void EraseShortcut(std::vector<int>* shortcuts, int shortcut) {
+  for (auto it = shortcuts->begin(); it != shortcuts->end();) {
+    if (*it == shortcut) {
+      it = shortcuts->erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+
+// Stores `shortcuts` as the user's list for `command_id`. A list equal to
+// the command's original shortcuts is not stored: the command then counts as
+// unchanged.
+void StoreShortcuts(const std::vector<ShortcutBinding>& defaults,
+                    ShortcutOverrides* overrides,
+                    int command_id,
+                    std::vector<int> shortcuts) {
+  if (shortcuts == DefaultsOf(defaults, command_id)) {
+    overrides->erase(command_id);
+  } else {
+    (*overrides)[command_id] = std::move(shortcuts);
+  }
+}
+
+std::string JsonString(std::string_view text) {
+  std::string result = "\"";
+  for (char c : text) {
+    if (c == '"' || c == '\\') {
+      result += '\\';
+    }
+    result += c;
+  }
+  result += '"';
+  return result;
+}
+
+}  // namespace
+
+const ShortcutCommand* FindShortcutCommand(std::string_view name) {
+  for (const ShortcutCommand& command : kCommands) {
+    if (name == command.name) {
+      return &command;
+    }
+  }
+  return nullptr;
+}
+
+const ShortcutCommand* FindShortcutCommandById(int command_id) {
+  for (const ShortcutCommand& command : kCommands) {
+    if (command.id == command_id) {
+      return &command;
+    }
+  }
+  return nullptr;
+}
+
+bool IsStoredShortcut(int shortcut) {
+  return shortcut > 0 && ShortcutKey(shortcut) != 0 &&
+         ShortcutModifiers(shortcut) <=
+             (kShortcutCtrl | kShortcutShift | kShortcutAlt | kShortcutAltGr);
+}
+
+std::string ShortcutText(int shortcut) {
+  const int modifiers = ShortcutModifiers(shortcut);
+  std::string text;
+  if (modifiers & kShortcutCtrl) {
+    text += "Ctrl+";
+  }
+  if (modifiers & kShortcutAlt) {
+    text += "Alt+";
+  }
+  if (modifiers & kShortcutAltGr) {
+    text += "AltGr+";
+  }
+  if (modifiers & kShortcutShift) {
+    text += "Shift+";
+  }
+  return text + KeyText(ShortcutKey(shortcut));
+}
+
+void SanitizeShortcutOverrides(ShortcutOverrides* overrides) {
+  std::set<int> seen;
+  for (auto it = overrides->begin(); it != overrides->end();) {
+    if (!FindShortcutCommandById(it->first)) {
+      it = overrides->erase(it);
+      continue;
+    }
+    std::vector<int> kept;
+    for (int shortcut : it->second) {
+      if (IsStoredShortcut(shortcut) && seen.insert(shortcut).second) {
+        kept.push_back(shortcut);
+      }
+    }
+    it->second = std::move(kept);
+    ++it;
+  }
+}
+
+std::vector<ShortcutBinding> EffectiveShortcuts(
+    const std::vector<ShortcutBinding>& defaults,
+    const ShortcutOverrides& overrides) {
+  std::set<int> taken;
+  for (const auto& [command_id, shortcuts] : overrides) {
+    taken.insert(shortcuts.begin(), shortcuts.end());
+  }
+  std::vector<ShortcutBinding> result;
+  for (const ShortcutBinding& binding : defaults) {
+    if (!overrides.contains(binding.command_id) &&
+        !taken.contains(binding.shortcut)) {
+      result.push_back(binding);
+    }
+  }
+  for (const auto& [command_id, shortcuts] : overrides) {
+    for (int shortcut : shortcuts) {
+      result.push_back({shortcut, command_id});
+    }
+  }
+  return result;
+}
+
+ShortcutChange AddShortcut(const std::vector<ShortcutBinding>& defaults,
+                           ShortcutOverrides* overrides,
+                           int command_id,
+                           int shortcut,
+                           bool take_over) {
+  ShortcutChange change;
+  change.result = ShortcutResult::kError;
+  if (!FindShortcutCommandById(command_id)) {
+    change.message = "This command is not known.";
+    return change;
+  }
+  const int key = ShortcutKey(shortcut);
+  const int modifiers = ShortcutModifiers(shortcut);
+  if (!IsStoredShortcut(shortcut) || (modifiers & kShortcutAltGr) ||
+      !CanAssignKey(key)) {
+    change.message = "This key cannot be used in a shortcut.";
+    return change;
+  }
+  const std::string text = ShortcutText(shortcut);
+  if (!(modifiers & (kShortcutCtrl | kShortcutAlt)) && !IsFunctionKey(key)) {
+    change.message = text +
+                     " cannot be used. A shortcut needs Ctrl or Alt, unless "
+                     "it is a function key.";
+    return change;
+  }
+  if (IsEditingShortcut(shortcut)) {
+    change.message = text + " is used for editing text and cannot be changed.";
+    return change;
+  }
+  if (IsWindowsShortcut(shortcut)) {
+    change.message = text + " is used by Windows.";
+    return change;
+  }
+
+  std::vector<int> shortcuts = CurrentOf(defaults, *overrides, command_id);
+  for (int entry : shortcuts) {
+    if (entry == shortcut) {
+      change.result = ShortcutResult::kOk;
+      return change;
+    }
+  }
+
+  for (const ShortcutBinding& binding :
+       EffectiveShortcuts(defaults, *overrides)) {
+    if (binding.shortcut != shortcut) {
+      continue;
+    }
+    const ShortcutCommand* owner = FindShortcutCommandById(binding.command_id);
+    if (!owner) {
+      change.message =
+          text + " belongs to a built-in function that cannot be changed.";
+      return change;
+    }
+    if (!take_over) {
+      change.result = ShortcutResult::kConflict;
+      change.owner = owner->label;
+      return change;
+    }
+    auto it = overrides->find(owner->id);
+    if (it != overrides->end()) {
+      std::vector<int> owner_shortcuts = it->second;
+      EraseShortcut(&owner_shortcuts, shortcut);
+      StoreShortcuts(defaults, overrides, owner->id,
+                     std::move(owner_shortcuts));
+    }
+    // An owner without a list of its own loses the shortcut because the
+    // user's list below now has it.
+  }
+
+  shortcuts.push_back(shortcut);
+  StoreShortcuts(defaults, overrides, command_id, std::move(shortcuts));
+  change.result = ShortcutResult::kOk;
+  return change;
+}
+
+void RemoveShortcut(const std::vector<ShortcutBinding>& defaults,
+                    ShortcutOverrides* overrides,
+                    int command_id,
+                    int shortcut) {
+  if (!FindShortcutCommandById(command_id)) {
+    return;
+  }
+  std::vector<int> shortcuts = CurrentOf(defaults, *overrides, command_id);
+  EraseShortcut(&shortcuts, shortcut);
+  StoreShortcuts(defaults, overrides, command_id, std::move(shortcuts));
+}
+
+void ResetShortcuts(ShortcutOverrides* overrides, int command_id) {
+  overrides->erase(command_id);
+}
+
+void MergeShortcutOverrides(const std::vector<ShortcutBinding>& defaults,
+                            ShortcutOverrides* overrides,
+                            const ShortcutOverrides& incoming) {
+  for (const auto& [command_id, shortcuts] : incoming) {
+    if (!FindShortcutCommandById(command_id)) {
+      continue;
+    }
+    // Take the incoming shortcuts away from the commands the user gave them
+    // to.
+    std::vector<int> owners;
+    for (const auto& [owner_id, owner_shortcuts] : *overrides) {
+      if (owner_id != command_id) {
+        owners.push_back(owner_id);
+      }
+    }
+    for (int owner_id : owners) {
+      std::vector<int> owner_shortcuts = (*overrides)[owner_id];
+      const size_t size_before = owner_shortcuts.size();
+      for (int shortcut : shortcuts) {
+        EraseShortcut(&owner_shortcuts, shortcut);
+      }
+      if (owner_shortcuts.size() != size_before) {
+        StoreShortcuts(defaults, overrides, owner_id,
+                       std::move(owner_shortcuts));
+      }
+    }
+    StoreShortcuts(defaults, overrides, command_id, shortcuts);
+  }
+  SanitizeShortcutOverrides(overrides);
+}
+
+std::string ShortcutStateJson(const std::vector<ShortcutBinding>& defaults,
+                              const ShortcutOverrides& overrides) {
+  std::string json = "{\"custom\":";
+  json += overrides.empty() ? "false" : "true";
+  json += ",\"sections\":[";
+  const char* section = nullptr;
+  bool first_command = true;
+  for (const ShortcutCommand& command : kCommands) {
+    if (command.section != section) {
+      if (section) {
+        json += "]},";
+      }
+      section = command.section;
+      json += "{\"title\":" + JsonString(section) + ",\"commands\":[";
+      first_command = true;
+    }
+    if (!first_command) {
+      json += ",";
+    }
+    first_command = false;
+
+    const std::vector<int> original = DefaultsOf(defaults, command.id);
+    const std::vector<int> current = CurrentOf(defaults, overrides, command.id);
+    const bool custom = overrides.contains(command.id);
+    json += "{\"id\":" + JsonString(command.name) +
+            ",\"label\":" + JsonString(command.label) +
+            ",\"custom\":" + (custom ? "true" : "false") +
+            ",\"changed\":" + (current != original ? "true" : "false") +
+            ",\"shortcuts\":[";
+    for (size_t i = 0; i < current.size(); ++i) {
+      json += std::string(i ? "," : "") +
+              "{\"k\":" + std::to_string(current[i]) +
+              ",\"text\":" + JsonString(ShortcutText(current[i])) + "}";
+    }
+    // Original shortcuts that another command has now.
+    json += "],\"lost\":[";
+    bool first_lost = true;
+    if (!custom) {
+      for (int shortcut : original) {
+        const ShortcutCommand* owner = UserOwner(overrides, shortcut);
+        if (!owner) {
+          continue;
+        }
+        json += std::string(first_lost ? "" : ",") +
+                "{\"text\":" + JsonString(ShortcutText(shortcut)) +
+                ",\"by\":" + JsonString(owner->label) + "}";
+        first_lost = false;
+      }
+    }
+    json += "]}";
+  }
+  if (section) {
+    json += "]}";
+  }
+  json += "]}";
+  return json;
+}
+
+std::string ShortcutResponseJson(const ShortcutChange& change,
+                                 int shortcut,
+                                 const std::vector<ShortcutBinding>& defaults,
+                                 const ShortcutOverrides& overrides) {
+  std::string json = "{\"status\":";
+  switch (change.result) {
+    case ShortcutResult::kOk:
+      json += "\"ok\"";
+      break;
+    case ShortcutResult::kError:
+      json += "\"error\",\"message\":" + JsonString(change.message);
+      break;
+    case ShortcutResult::kConflict:
+      json += "\"conflict\",\"k\":" + std::to_string(shortcut) +
+              ",\"text\":" + JsonString(ShortcutText(shortcut)) +
+              ",\"owner\":" + JsonString(change.owner);
+      break;
+  }
+  json += ",\"state\":" + ShortcutStateJson(defaults, overrides) + "}";
+  return json;
+}
+
+}  // namespace yatesium
diff --git a/chrome/browser/yatesium_shortcut_table.h b/chrome/browser/yatesium_shortcut_table.h
new file mode 100644
index 000000000..8823f60f6
--- /dev/null
+++ b/chrome/browser/yatesium_shortcut_table.h
@@ -0,0 +1,126 @@
+// Yatesium: the data behind the keyboard shortcuts page.
+//
+// This file and its .cc use only the C++ standard library and the command
+// ids. The part that talks to the browser is in yatesium_shortcuts.cc.
+//
+// A shortcut is stored as one int: the modifier bits shifted left by 8, plus
+// the Windows virtual key code. The user's changes are a map from a command
+// to the complete list of shortcuts that command now has. A command that is
+// not in the map keeps the shortcuts Chromium gives it, except those the user
+// gave to another command.
+
+#ifndef CHROME_BROWSER_YATESIUM_SHORTCUT_TABLE_H_
+#define CHROME_BROWSER_YATESIUM_SHORTCUT_TABLE_H_
+
+#include <map>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace yatesium {
+
+inline constexpr int kShortcutCtrl = 1;
+inline constexpr int kShortcutShift = 2;
+inline constexpr int kShortcutAlt = 4;
+inline constexpr int kShortcutAltGr = 8;
+
+constexpr int MakeShortcut(int modifiers, int key) {
+  return (modifiers << 8) | key;
+}
+constexpr int ShortcutKey(int shortcut) {
+  return shortcut & 0xFF;
+}
+constexpr int ShortcutModifiers(int shortcut) {
+  return shortcut >> 8;
+}
+
+// One shortcut and the command (IDC_...) it runs.
+struct ShortcutBinding {
+  int shortcut;
+  int command_id;
+};
+
+// Command id to the shortcuts the user chose for it.
+using ShortcutOverrides = std::map<int, std::vector<int>>;
+
+// A command the page offers.
+struct ShortcutCommand {
+  int id;
+  // Name used in the stored settings and in the page's requests.
+  const char* name;
+  // Text shown on the page.
+  const char* label;
+  // Heading the command is listed under.
+  const char* section;
+};
+
+const ShortcutCommand* FindShortcutCommand(std::string_view name);
+const ShortcutCommand* FindShortcutCommandById(int command_id);
+
+// True if `shortcut` has a key code and modifier bits in the stored range.
+bool IsStoredShortcut(int shortcut);
+
+// "Ctrl+Shift+T".
+std::string ShortcutText(int shortcut);
+
+// Removes entries that cannot be used: commands the page does not offer,
+// values out of range, and a shortcut listed a second time.
+void SanitizeShortcutOverrides(ShortcutOverrides* overrides);
+
+// The shortcuts in effect: `defaults` with the user's changes applied.
+std::vector<ShortcutBinding> EffectiveShortcuts(
+    const std::vector<ShortcutBinding>& defaults,
+    const ShortcutOverrides& overrides);
+
+enum class ShortcutResult {
+  kOk,
+  // Refused. `message` says why.
+  kError,
+  // The shortcut belongs to another command. `owner` is that command's label.
+  kConflict,
+};
+
+struct ShortcutChange {
+  ShortcutResult result = ShortcutResult::kOk;
+  std::string message;
+  std::string owner;
+};
+
+// Gives `shortcut` to `command_id`. If another command has it, the result is
+// kConflict and nothing changes, unless `take_over` is true.
+ShortcutChange AddShortcut(const std::vector<ShortcutBinding>& defaults,
+                           ShortcutOverrides* overrides,
+                           int command_id,
+                           int shortcut,
+                           bool take_over);
+
+void RemoveShortcut(const std::vector<ShortcutBinding>& defaults,
+                    ShortcutOverrides* overrides,
+                    int command_id,
+                    int shortcut);
+
+// Gives `command_id` its original shortcuts back, apart from those the user
+// gave to another command.
+void ResetShortcuts(ShortcutOverrides* overrides, int command_id);
+
+// Applies the changes of a settings file. Each command in `incoming` gets
+// the shortcuts listed there, and another command that had one of them loses
+// it. Commands that are not in `incoming` keep what they have.
+void MergeShortcutOverrides(const std::vector<ShortcutBinding>& defaults,
+                            ShortcutOverrides* overrides,
+                            const ShortcutOverrides& incoming);
+
+// What the page shows, as JSON.
+std::string ShortcutStateJson(const std::vector<ShortcutBinding>& defaults,
+                              const ShortcutOverrides& overrides);
+
+// The answer to a request of the page: the outcome of `change` for
+// `shortcut`, and the state after it.
+std::string ShortcutResponseJson(const ShortcutChange& change,
+                                 int shortcut,
+                                 const std::vector<ShortcutBinding>& defaults,
+                                 const ShortcutOverrides& overrides);
+
+}  // namespace yatesium
+
+#endif  // CHROME_BROWSER_YATESIUM_SHORTCUT_TABLE_H_
diff --git a/chrome/browser/yatesium_shortcuts.cc b/chrome/browser/yatesium_shortcuts.cc
new file mode 100644
index 000000000..af531d560
--- /dev/null
+++ b/chrome/browser/yatesium_shortcuts.cc
@@ -0,0 +1,936 @@
+// Yatesium: the keyboard shortcuts page. See yatesium_shortcuts.h.
+//
+// How it works: Chromium builds its list of shortcuts once and every browser
+// window copies it. A filter installed here rewrites that list with the
+// user's changes (see accelerator_table.h). When the page changes something,
+// the list is built again and every window loads it again.
+//
+// The page is HTML with a script, both served from here. The script sends
+// each change as a request to this page's own address ("add?...",
+// "remove?...", "reset?...", "resetall?...") and gets the new state back as
+// JSON. The rules for what a change does are in yatesium_shortcut_table.cc.
+
+#include "chrome/browser/yatesium_shortcuts.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/memory/ref_counted_memory.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/unguessable_token.h"
+#include "base/values.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/accelerator_table.h"
+#include "chrome/browser/yatesium_shortcut_table.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/url_data_source.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/common/url_constants.h"
+#include "net/base/url_util.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "url/gurl.h"
+
+namespace yatesium {
+
+namespace {
+
+// Local State: a dictionary from a command's name to the list of its
+// shortcuts. Only commands the user changed are in it.
+constexpr char kShortcutsPref[] = "yatesium.shortcuts";
+
+// The modifier flags a stored shortcut can express.
+constexpr int kKnownFlags = ui::EF_CONTROL_DOWN | ui::EF_SHIFT_DOWN |
+                            ui::EF_ALT_DOWN | ui::EF_ALTGR_DOWN;
+
+// Chromium's own shortcuts, as of the last time the list was built.
+std::vector<ShortcutBinding>& DefaultBindings() {
+  static base::NoDestructor<std::vector<ShortcutBinding>> bindings;
+  return *bindings;
+}
+
+// Returns nothing for a mapping that a stored shortcut cannot express. Such
+// a mapping is left as it is.
+std::optional<int> ToShortcut(const AcceleratorMapping& mapping) {
+  const int key = static_cast<int>(mapping.keycode);
+  if ((mapping.modifiers & ~kKnownFlags) || key <= 0 || key > 0xFF) {
+    return std::nullopt;
+  }
+  int modifiers = 0;
+  if (mapping.modifiers & ui::EF_CONTROL_DOWN) {
+    modifiers |= kShortcutCtrl;
+  }
+  if (mapping.modifiers & ui::EF_SHIFT_DOWN) {
+    modifiers |= kShortcutShift;
+  }
+  if (mapping.modifiers & ui::EF_ALT_DOWN) {
+    modifiers |= kShortcutAlt;
+  }
+  if (mapping.modifiers & ui::EF_ALTGR_DOWN) {
+    modifiers |= kShortcutAltGr;
+  }
+  return MakeShortcut(modifiers, key);
+}
+
+AcceleratorMapping ToMapping(const ShortcutBinding& binding) {
+  const int modifiers = ShortcutModifiers(binding.shortcut);
+  int flags = ui::EF_NONE;
+  if (modifiers & kShortcutCtrl) {
+    flags |= ui::EF_CONTROL_DOWN;
+  }
+  if (modifiers & kShortcutShift) {
+    flags |= ui::EF_SHIFT_DOWN;
+  }
+  if (modifiers & kShortcutAlt) {
+    flags |= ui::EF_ALT_DOWN;
+  }
+  if (modifiers & kShortcutAltGr) {
+    flags |= ui::EF_ALTGR_DOWN;
+  }
+  return AcceleratorMapping{
+      static_cast<ui::KeyboardCode>(ShortcutKey(binding.shortcut)), flags,
+      binding.command_id, std::nullopt};
+}
+
+PrefService* LocalState() {
+  return g_browser_process ? g_browser_process->local_state() : nullptr;
+}
+
+// The stored form of the user's changes: a dictionary from a command's name
+// to the list of its shortcuts. Local State and a settings file both use it.
+ShortcutOverrides OverridesFromDict(const base::DictValue& dict) {
+  ShortcutOverrides overrides;
+  for (const auto item : dict) {
+    const ShortcutCommand* command = FindShortcutCommand(item.first);
+    if (!command || !item.second.is_list()) {
+      continue;
+    }
+    std::vector<int>& shortcuts = overrides[command->id];
+    for (const base::Value& entry : item.second.GetList()) {
+      if (entry.is_int()) {
+        shortcuts.push_back(entry.GetInt());
+      }
+    }
+  }
+  SanitizeShortcutOverrides(&overrides);
+  return overrides;
+}
+
+base::DictValue OverridesToDict(const ShortcutOverrides& overrides) {
+  base::DictValue dict;
+  for (const auto& [command_id, shortcuts] : overrides) {
+    const ShortcutCommand* command = FindShortcutCommandById(command_id);
+    if (!command) {
+      continue;
+    }
+    base::ListValue list;
+    for (int shortcut : shortcuts) {
+      list.Append(shortcut);
+    }
+    dict.Set(command->name, std::move(list));
+  }
+  return dict;
+}
+
+ShortcutOverrides LoadOverrides() {
+  PrefService* local_state = LocalState();
+  if (!local_state) {
+    return ShortcutOverrides();
+  }
+  return OverridesFromDict(local_state->GetDict(kShortcutsPref));
+}
+
+void SaveOverrides(const ShortcutOverrides& overrides) {
+  PrefService* local_state = LocalState();
+  if (!local_state) {
+    return;
+  }
+  local_state->SetDict(kShortcutsPref, OverridesToDict(overrides));
+}
+
+// The key of a settings file's shortcuts, next to "format".
+constexpr char kJsonShortcutsKey[] = "shortcuts";
+
+// Reads what ExportShortcutsJson() writes.
+std::optional<ShortcutOverrides> OverridesFromJson(const std::string& json) {
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  const base::DictValue* dict =
+      root ? root->FindDict(kJsonShortcutsKey) : nullptr;
+  if (!dict) {
+    return std::nullopt;
+  }
+  return OverridesFromDict(*dict);
+}
+
+// The filter of the accelerator list. `list` arrives with Chromium's own
+// shortcuts and leaves with the ones in effect.
+void FilterAcceleratorList(std::vector<AcceleratorMapping>* list) {
+  std::vector<AcceleratorMapping> result;
+  std::vector<ShortcutBinding> defaults;
+  for (const AcceleratorMapping& mapping : *list) {
+    if (std::optional<int> shortcut = ToShortcut(mapping)) {
+      defaults.push_back({*shortcut, mapping.command_id});
+    } else {
+      result.push_back(mapping);
+    }
+  }
+  for (const ShortcutBinding& binding :
+       EffectiveShortcuts(defaults, LoadOverrides())) {
+    result.push_back(ToMapping(binding));
+  }
+  DefaultBindings() = std::move(defaults);
+  *list = std::move(result);
+}
+
+// The look of the page. Served as "style.css".
+constexpr char kStyleSheet[] = R"css(
+:root {
+  color-scheme: light dark;
+  --bg: #f6f7f9;
+  --card: #ffffff;
+  --text: #1f2328;
+  --muted: #5f6b7a;
+  --line: #dfe3e8;
+  --accent: #1a73e8;
+  --accent-text: #ffffff;
+  --danger: #c5221f;
+  --chip: #eef1f5;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #1b1d21;
+    --card: #25282d;
+    --text: #e6e8eb;
+    --muted: #9aa4b2;
+    --line: #3a3f46;
+    --accent: #8ab4f8;
+    --accent-text: #11151a;
+    --danger: #f28b82;
+    --chip: #33383f;
+  }
+}
+* { box-sizing: border-box; }
+[hidden] { display: none !important; }
+body {
+  margin: 0;
+  background: var(--bg);
+  color: var(--text);
+  font: 14px/1.5 "Segoe UI", system-ui, sans-serif;
+}
