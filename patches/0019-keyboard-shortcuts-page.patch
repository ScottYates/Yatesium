+void BrowserView::ReloadAccelerators() {
+  views::FocusManager* focus_manager = GetFocusManager();
+  if (!focus_manager) {
+    return;
+  }
+  // Unregister what LoadAccelerators() registered: the table and, where
+  // LoadAccelerators() registers them, the two Esc accelerators if the table
+  // does not have them.
+  for (const auto& entry : accelerator_table_) {
+    focus_manager->UnregisterAccelerator(entry.first, this);
+  }
+#if BUILDFLAG(IS_MAC)
+  const ui::Accelerator escape_pressed(ui::VKEY_ESCAPE, ui::EF_NONE,
+                                       ui::Accelerator::KeyState::PRESSED);
+  if (accelerator_table_.find(escape_pressed) == accelerator_table_.end()) {
+    focus_manager->UnregisterAccelerator(escape_pressed, this);
+  }
+  const ui::Accelerator escape_released(ui::VKEY_ESCAPE, ui::EF_NONE,
+                                        ui::Accelerator::KeyState::RELEASED);
+  if (accelerator_table_.find(escape_released) == accelerator_table_.end()) {
+    focus_manager->UnregisterAccelerator(escape_released, this);
+  }
+#endif
+  accelerator_table_.clear();
+  LoadAccelerators();
+}
