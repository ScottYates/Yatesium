+// Yatesium: the keyboard shortcuts page (yatesium://shortcuts,
+// chrome://shortcuts) and the shortcuts the user changed there.
+//
+// The page lists the browser's commands with their shortcuts. The user can
+// add a shortcut to a command, remove one, and go back to the original ones.
+// A change applies at once to every open window. The changes are kept in
+// Local State, so they hold for every profile.
+
+#ifndef CHROME_BROWSER_YATESIUM_SHORTCUTS_H_
+#define CHROME_BROWSER_YATESIUM_SHORTCUTS_H_
+
+#include "content/public/browser/web_ui_controller.h"
+#include "content/public/browser/webui_config.h"
+
+class PrefRegistrySimple;
+
+namespace content {
+class WebContents;
+class WebUI;
+}  // namespace content
+
+namespace yatesium {
+
+inline constexpr char kShortcutsHost[] = "shortcuts";
+
+// Registers the Local State entry that holds the user's changes.
+void RegisterShortcutPrefs(PrefRegistrySimple* registry);
+
+// Makes the browser use the user's changes. Call once at startup, after
+// Local State exists and before the first browser window is created.
+void InitShortcuts();
+
+// The shortcuts the user changed, as JSON, for a settings file (see
+// yatesium_import.h). Call on the UI thread.
+std::string ExportShortcutsJson();
+
+// The number of commands whose shortcuts `json` changes, or -1 if `json` is
+// not what ExportShortcutsJson() writes.
+int CountShortcutsInJson(const std::string& json);
+
+// Applies the shortcuts in `json`, in every open window. With `replace`, the
+// browser ends up with exactly the changes in `json`. Without it, the
+// commands in `json` get the shortcuts from there and the other commands
+// keep theirs. Returns false if `json` is not valid; nothing changes then.
+// Call on the UI thread.
+bool ImportShortcutsJson(const std::string& json, bool replace);
+
+// True if `contents` shows the shortcuts page. A browser window sends key
+// presses to this page before it treats them as shortcuts, so that the page
+// can record a key combination that is in use.
+bool IsShortcutsPage(content::WebContents* contents);
+
+class ShortcutsUI : public content::WebUIController {
+ public:
+  explicit ShortcutsUI(content::WebUI* web_ui);
+  ShortcutsUI(const ShortcutsUI&) = delete;
+  ShortcutsUI& operator=(const ShortcutsUI&) = delete;
+  ~ShortcutsUI() override;
+};
+
+class ShortcutsUIConfig : public content::DefaultWebUIConfig<ShortcutsUI> {
+ public:
+  ShortcutsUIConfig();
+};
+
+}  // namespace yatesium
+
+#endif  // CHROME_BROWSER_YATESIUM_SHORTCUTS_H_
