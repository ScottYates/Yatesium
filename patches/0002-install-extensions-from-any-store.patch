 // Tests can call this method to inject a mock ExtensionInstallPrompt
diff --git a/extensions/browser/extension_util.cc b/extensions/browser/extension_util.cc
index 257e48e2..92316268 100644
--- a/extensions/browser/extension_util.cc
+++ b/extensions/browser/extension_util.cc
@@ -8,6 +8,7 @@
 
 #include "base/barrier_closure.h"
 #include "base/command_line.h"
+#include "base/files/file_path.h"
 #include "base/no_destructor.h"
 #include "base/strings/string_util.h"
 #include "build/chromeos_buildflags.h"
@@ -613,6 +614,20 @@ bool IsExtensionDownload(const download::DownloadItem& download_item) {
   if (download_item.GetMimeType() == Extension::kMimeType) {
     return true;
   }
+
+  // Yatesium: stores other than the Chrome Web Store often serve .crx files
+  // with a generic MIME type. Treat those as extension downloads too.
+  const std::string mime_type = download_item.GetMimeType();
+  if (mime_type.empty() || mime_type == "application/octet-stream" ||
+      mime_type == "application/x-crx" ||
+      mime_type == "application/x-opera-extension") {
+    if (base::EndsWith(download_item.GetURL().ExtractFileName(), ".crx",
+                       base::CompareCase::INSENSITIVE_ASCII) ||
+        download_item.GetTargetFilePath().MatchesExtension(
+            FILE_PATH_LITERAL(".crx"))) {
+      return true;
+    }
+  }
   return false;
 }
 
