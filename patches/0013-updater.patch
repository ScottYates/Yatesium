+}  // namespace
+
+int WINAPI wWinMain(HINSTANCE, HINSTANCE, wchar_t* command_line, int) {
+  const std::wstring arguments = command_line ? command_line : L"";
+  g_auto = arguments.find(L"--auto") != std::wstring::npos;
+
+  std::wstring release_base = kReleaseBase;
+#if defined(YATESIUM_UPDATE_TEST_SOURCE)
+  // Test builds can read releases from another server.
+  size_t source = arguments.find(L"--source=");
+  if (source != std::wstring::npos) {
+    release_base = arguments.substr(source + 9);
+    release_base = Trim(release_base.substr(0, release_base.find(L' ')));
+  }
+#endif
+
+  const std::wstring install_dir = ExeDir();
+  const std::wstring data_dir = install_dir + L"\\Data";
+  if (g_auto && PathExists(data_dir + L"\\no-update.txt")) {
+    return 0;
+  }
+
+  if (!g_auto && AllocConsole()) {
+    SetConsoleTitleW(L"Yatesium update");
+    g_console = GetStdHandle(STD_OUTPUT_HANDLE);
+  }
+
+  int exit_code = 0;
+  HANDLE mutex = CreateMutexW(nullptr, FALSE, MutexName(install_dir).c_str());
+  DWORD wait = mutex ? WaitForSingleObject(mutex, 0) : WAIT_FAILED;
+  if (wait != WAIT_OBJECT_0 && wait != WAIT_ABANDONED) {
+    // Another updater is already working on this folder.
+    Say(L"An update is already in progress for this folder.");
+  } else {
+    if (MakeDirs(data_dir + L"\\Update")) {
+      g_log_path = data_dir + L"\\Update\\update.log";
+      WIN32_FILE_ATTRIBUTE_DATA log_data;
+      if (GetFileAttributesExW(g_log_path.c_str(), GetFileExInfoStandard,
+                               &log_data) &&
+          (log_data.nFileSizeHigh != 0 || log_data.nFileSizeLow > 200000)) {
+        DeleteFileW(g_log_path.c_str());
+      }
+    }
+    std::wstring error;
+    if (!Update(install_dir, release_base, &error)) {
+      Say(L"Update failed: " + error + L".");
+      exit_code = 1;
+    }
+    ReleaseMutex(mutex);
+  }
+  if (mutex) {
+    CloseHandle(mutex);
+  }
+
+  if (g_console) {
+    const wchar_t kPrompt[] = L"\r\nPress Enter to close this window.";
+    DWORD count = 0;
+    WriteConsoleW(g_console, kPrompt, lstrlenW(kPrompt), &count, nullptr);
+    wchar_t input[8];
+    ReadConsoleW(GetStdHandle(STD_INPUT_HANDLE), input, 8, &count, nullptr);
+  }
+  return exit_code;
+}
