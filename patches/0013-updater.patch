+// Yatesium: starts the updater that ships next to the executable. It checks
+// for a newer release, downloads it, and swaps the files in after the browser
+// has closed. Nothing happens if the updater is not there.
+static void StartYatesiumUpdater() {
+  base::FilePath exe_dir;
+  if (!base::PathService::Get(base::DIR_EXE, &exe_dir)) {
+    return;
+  }
+  const base::FilePath updater = exe_dir.Append(L"yatesium_update.exe");
+  if (!base::PathExists(updater)) {
+    return;
+  }
+  const std::wstring command_line = L"\"" + updater.value() + L"\" --auto";
+  base::LaunchOptions options;
+  options.start_hidden = true;
+  base::LaunchProcess(command_line, options);
+}
